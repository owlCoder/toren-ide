<UserControl x:Class="Toren.App.Editor.Views.CSharpRenameOverlay"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,18,0,0"
             IsVisible="False">
  <Border Width="430"
          Padding="10"
          Background="{DynamicResource TorenSurfaceRaisedBrush}"
          BorderBrush="{DynamicResource TorenBorderStrongBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource TorenCardRadius}"
          BoxShadow="0 7 22 0 #66000000">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconCodeFile}" /><TextBlock Classes="panel-heading" Text="Rename symbol" /></StackPanel>
      <TextBox x:Name="NameBox"
               Height="34"
               MinHeight="34"
               Padding="10,5"
               FontFamily="Cascadia Code, Menlo, Consolas, monospace"
               FontSize="13"
               Background="{DynamicResource TorenBackgroundBrush}"
               Foreground="{DynamicResource TorenTextBrush}"
               BorderBrush="{DynamicResource TorenAccentBrush}"
               BorderThickness="1"
               CornerRadius="{StaticResource TorenControlRadius}"
               KeyDown="NameBox_OnKeyDown" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
        <TextBlock x:Name="HintText"
                   Text="Enter to apply · Esc to cancel" TextWrapping="Wrap"
                   FontSize="10.5"
                   Foreground="{DynamicResource TorenTextSubtleBrush}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="toolbar-button compact-action" Content="Cancel"
                MinWidth="70"
                Height="30"
                Click="CancelButton_OnClick" />
        <Button Grid.Column="2"
                Classes="primary-action compact-action icon-check" Content="Rename"
                MinWidth="74"
                Height="30"
                Click="RenameButton_OnClick" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
