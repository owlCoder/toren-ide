<UserControl x:Class="Toren.App.Editor.Views.WorkspaceQuickOpenOverlay"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspaceModels="clr-namespace:Toren.Workspaces.Models;assembly=Toren.Workspaces"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             Margin="12,18,12,12"
             MaxWidth="560"
             IsVisible="False">
  <UserControl.Styles>
    <Style Selector="Border.quick-open-card">
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="Background" Value="{DynamicResource TorenSurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BoxShadow" Value="0 7 22 0 #66000000" />
    </Style>
    <Style Selector="TextBox.quick-open-input">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource TorenBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.quick-open-results">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MaxHeight" Value="330" />
    </Style>
    <Style Selector="ListBox.quick-open-results > ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Border Classes="quick-open-card">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
      <TextBox x:Name="QueryBox"
               Classes="quick-open-input"
               PlaceholderText="Go to File"
               TextChanged="QueryBox_OnTextChanged"
               KeyDown="QueryBox_OnKeyDown" />

      <TextBlock Grid.Row="1" x:Name="StatusText"
                 Text="Type to filter workspace files"
                 FontSize="10.5"
                 Foreground="{DynamicResource TorenTextSubtleBrush}"
                 Margin="2,0" />

      <ListBox Grid.Row="2" x:Name="ResultsList"
               Classes="quick-open-results"
               DoubleTapped="ResultsList_OnDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="workspaceModels:WorkspaceFileEntry">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="9">
              <Border Grid.RowSpan="2" Width="22" Height="22"
                      VerticalAlignment="Center"
                      Background="{DynamicResource TorenSurfaceHoverBrush}"
                      CornerRadius="3">
                <Path Width="12" Height="12" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{DynamicResource TorenTextMutedBrush}" StrokeThickness="1.4"
                      Data="M4,2.5 H10 L13,5.5 V13.5 H4 Z M10,2.5 V5.5 H13" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Name}"
                         FontSize="12.5"
                         Foreground="{DynamicResource TorenTextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="{Binding RelativePath}"
                         FontSize="10.5"
                         Foreground="{DynamicResource TorenTextSubtleBrush}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
