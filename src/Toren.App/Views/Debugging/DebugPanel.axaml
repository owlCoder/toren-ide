<UserControl x:Class="Toren.App.Views.Debugging.DebugPanel"
             x:ClassModifier="internal"
             x:DataType="debugvm:DebugSessionViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:debugvm="clr-namespace:Toren.App.Debugging.ViewModels"
             xmlns:debugmodels="clr-namespace:Toren.Debugging.Models;assembly=Toren.Debugging">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <Border Classes="panel-header">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconDebug}" /><TextBlock Classes="panel-heading" Text="Debug" /></StackPanel>
        <Border Grid.Column="1" Classes="status-badge">
          <Grid><TextBlock Text="Attached" FontSize="10" IsVisible="{Binding IsAttached}" Foreground="{DynamicResource TorenSuccessBrush}" /><TextBlock Text="Offline" FontSize="10" Classes="muted" IsVisible="{Binding !IsAttached}" /></Grid>
        </Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Classes="panel-card" Margin="10,8,10,4">
      <StackPanel Spacing="6">
        <TextBlock Classes="field-label" Text="Attach to a .NET process" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox PlaceholderText="Process ID" Text="{Binding AttachProcessId, Mode=TwoWay}" KeyDown="AttachProcessId_OnKeyDown" AutomationProperties.Name="Process ID to attach" />
          <Button Classes="toolbar-button compact-action icon-debug" Content="Attach" ToolTip.Tip="Attach" AutomationProperties.Name="Attach" Grid.Column="1" Click="AttachProcess_OnClick" IsEnabled="{Binding CanAttach}" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="10,0" Padding="0,4" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <WrapPanel Classes="tool-actions">
        <Button Classes="toolbar-button compact-action icon-run icon-only" Content="Continue" ToolTip.Tip="Continue" AutomationProperties.Name="Continue" Click="Continue_OnClick" IsEnabled="{Binding CanContinue}" />
        <Button Classes="toolbar-button compact-action icon-pause icon-only" Content="Pause" ToolTip.Tip="Pause" AutomationProperties.Name="Pause" Click="Pause_OnClick" IsEnabled="{Binding CanPause}" />
        <Button Classes="toolbar-button compact-action icon-step-over icon-only" Content="Step Over" ToolTip.Tip="Step Over" AutomationProperties.Name="Step Over" Click="StepOver_OnClick" IsEnabled="{Binding CanStep}" />
        <Button Classes="toolbar-button compact-action icon-step-into icon-only" Content="Step Into" ToolTip.Tip="Step Into" AutomationProperties.Name="Step Into" Click="StepInto_OnClick" IsEnabled="{Binding CanStep}" />
        <Button Classes="toolbar-button compact-action icon-step-out icon-only" Content="Step Out" ToolTip.Tip="Step Out" AutomationProperties.Name="Step Out" Click="StepOut_OnClick" IsEnabled="{Binding CanStep}" />
        <Button Classes="toolbar-button compact-action icon-cursor icon-only" Content="Run to Cursor" ToolTip.Tip="Run to Cursor" AutomationProperties.Name="Run to Cursor" Click="RunToCursor_OnClick" IsEnabled="{Binding CanRunToCursor}" />
        <Button Classes="toolbar-button compact-action icon-refresh icon-only" Content="Restart" ToolTip.Tip="Restart" AutomationProperties.Name="Restart" Click="Restart_OnClick" IsEnabled="{Binding CanRestart}" />
        <Button Classes="toolbar-button compact-action icon-stop icon-only" Content="Stop" ToolTip.Tip="Stop" AutomationProperties.Name="Stop" Click="Stop_OnClick" IsEnabled="{Binding CanStop}" />
      </WrapPanel>
    </Border>
    <ComboBox Grid.Row="3" Margin="10,8" HorizontalAlignment="Stretch"
              SelectedIndex="{Binding #DebugViews.SelectedIndex, Mode=TwoWay}"
              AutomationProperties.Name="Debug view">
      <ComboBoxItem Content="Call Stack" />
      <ComboBoxItem Content="Locals" />
      <ComboBoxItem Content="Watch" />
      <ComboBoxItem Content="Breakpoints" />
      <ComboBoxItem Content="Debug Console" />
    </ComboBox>
    <TabControl x:Name="DebugViews" Grid.Row="4" Classes="tool-tabs sidebar-pages">
      <TabItem Header="Call Stack">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Margin="10,8,10,4" Classes="muted" FontSize="11"
                     Text="Double-click a frame to open its source." TextWrapping="Wrap" />
          <ListBox Grid.Row="1" ItemsSource="{Binding StackFrames}"
                   SelectionChanged="StackFrames_OnSelectionChanged"
                   DoubleTapped="StackFrames_OnDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="debugmodels:DebugStackFrame">
                <Grid Margin="8,3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding SourcePath}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="muted" FontSize="11"
                             Text="{Binding Line, StringFormat='Line {0}'}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Locals">
        <ListBox ItemsSource="{Binding Locals}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="debugvm:DebugLocalItemViewModel">
              <Grid Margin="8,3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding ScopeName}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value}" ToolTip.Tip="{Binding Value}" FontSize="11"
                           FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Type}" ToolTip.Tip="{Binding Type}" MaxWidth="90" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>

      <TabItem Header="Watch">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" PlaceholderText="Expression"
                     Text="{Binding WatchExpression, Mode=TwoWay}" KeyDown="WatchExpression_OnKeyDown"
                     AutomationProperties.Name="Watch expression" />
            <Button Grid.Column="1" Classes="toolbar-button compact-action icon-add icon-only" Content="Add" ToolTip.Tip="Add watch expression"
                    Click="AddWatch_OnClick" AutomationProperties.Name="Add watch expression" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Watches}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="debugvm:DebugWatchItemViewModel">
                <Grid Margin="8,3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding Expression}" ToolTip.Tip="{Binding Expression}" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="1">
                    <TextBlock Text="{Binding Value}" ToolTip.Tip="{Binding Value}" FontSize="11"
                               FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource TorenErrorBrush}"
                               Text="{Binding ErrorMessage}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Type}" ToolTip.Tip="{Binding Type}" FontSize="11" />
                  <Button Grid.Column="1" Classes="toolbar-button compact-action icon-delete icon-only" Content="Remove" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                          Click="RemoveWatch_OnClick" Padding="6,1" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Breakpoints">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="10,8" RowDefinitions="Auto,Auto" RowSpacing="6">
            <TextBox Grid.Column="0" PlaceholderText="Optional condition"
                     Text="{Binding BreakpointCondition, Mode=TwoWay}"
                     AutomationProperties.Name="Breakpoint condition" />
            <Button Grid.Row="1" Classes="primary-action compact-action icon-add" Content="Add at Caret"
                    Click="AddBreakpoint_OnClick" AutomationProperties.Name="Add breakpoint at caret" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Breakpoints}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="debugvm:DebugBreakpointItemViewModel">
                <Grid Margin="8,3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="11"
                             ToolTip.Tip="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Line}" FontSize="11" />
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="1">
                    <TextBlock Text="{Binding Condition}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Message}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="toolbar-button compact-action icon-delete icon-only" Content="Remove" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                          Click="RemoveBreakpoint_OnClick" Padding="6,1" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Debug Console">
        <Grid RowDefinitions="*,Auto">
          <ListBox Grid.Row="0" ItemsSource="{Binding ConsoleLines}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="debugvm:DebugConsoleLineViewModel">
                <TextBlock Margin="8,2" Text="{Binding Text}" FontSize="11"
                           FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="1" Margin="10,8" RowDefinitions="Auto,Auto" RowSpacing="6">
            <TextBox Grid.Column="0" PlaceholderText="Evaluate expression"
                     Text="{Binding ConsoleExpression, Mode=TwoWay}" KeyDown="ConsoleExpression_OnKeyDown"
                     AutomationProperties.Name="Debug console expression" />
            <WrapPanel Grid.Row="1" Classes="tool-actions">
            <Button Classes="primary-action compact-action icon-run" Content="Evaluate"
                    Click="EvaluateConsole_OnClick" IsEnabled="{Binding CanEvaluate}"
                    AutomationProperties.Name="Evaluate debug expression" />
            <Button Classes="toolbar-button compact-action icon-delete" Content="Clear"
                    Click="ClearConsole_OnClick" IsEnabled="{Binding HasConsoleLines}"
                    AutomationProperties.Name="Clear debug console" />
            </WrapPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
