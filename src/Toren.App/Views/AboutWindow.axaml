<Window
    x:Class="Toren.App.Views.AboutWindow"
    x:DataType="vm:AboutWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Toren.App.ViewModels"
    Width="500"
    Height="370"
    CanResize="False"
    SystemDecorations="None"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="About Toren IDE">

  <Grid RowDefinitions="40,Auto,*,Auto">
    <Border
        Grid.Row="0"
        Classes="title-bar"
        BorderBrush="{DynamicResource TorenBorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <Border
            Grid.Column="0"
            Padding="14,0"
            Background="Transparent"
            PointerPressed="TitleBar_OnPointerPressed">
          <TextBlock
              Text="About Toren IDE"
              VerticalAlignment="Center"
              FontSize="12"
              FontWeight="SemiBold"
              Classes="muted" />
        </Border>
        <Button
            Grid.Column="1"
            Classes="window-control close"
            Width="42"
            Height="40"
            Content="×"
            Click="CloseWindow_OnClick"
            ToolTip.Tip="Close" />
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="22,18"
        Background="{DynamicResource TorenSurfaceBrush}"
        BorderBrush="{DynamicResource TorenBorderBrush}"
        BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border
            Width="44"
            Height="44"
            Background="{DynamicResource TorenAccentMutedBrush}"
            BorderBrush="{DynamicResource TorenAccentBrush}"
            BorderThickness="1"
            CornerRadius="10">
          <TextBlock
              Text="T"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="22"
              FontWeight="Bold"
              Foreground="{DynamicResource TorenAccentBrush}" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="22,20" Spacing="14">
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" />
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Open source" Classes="section-label" />
          <TextBlock Text="{Binding License}" FontSize="12" />
          <TextBlock Text="{Binding Repository}" Classes="muted" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Border
        Grid.Row="3"
        Padding="18,12"
        Background="{DynamicResource TorenSurfaceBrush}"
        BorderBrush="{DynamicResource TorenBorderBrush}"
        BorderThickness="0,1,0,0">
      <Button
          Classes="primary-action"
          Content="Close"
          HorizontalAlignment="Right"
          IsCancel="True"
          MinWidth="84" />
    </Border>
  </Grid>
</Window>
