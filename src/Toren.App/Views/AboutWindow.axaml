<Window x:Class="Toren.App.Views.AboutWindow"
        x:ClassModifier="internal"
        x:DataType="vm:AboutWindowViewModel"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toren.App.ViewModels"
        Width="480" Height="324" CanResize="False"
        WindowDecorations="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="About Toren IDE">
  <Grid RowDefinitions="46,*,58">
    <Border Grid.Row="0" Classes="title-bar"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <Border Padding="16,0" Background="Transparent"
                PointerPressed="TitleBar_OnPointerPressed">
          <TextBlock Text="About Toren IDE" Classes="muted chrome-label"
                     FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Button Grid.Column="1" Classes="window-control close" Width="44" Height="46"
                Click="CloseWindow_OnClick" ToolTip.Tip="Close"
                AutomationProperties.Name="Close About window">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconClose}"
                Width="14" Height="14" />
        </Button>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="22,20" Spacing="15">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Width="44" Height="44" CornerRadius="9"
                Background="{DynamicResource TorenAccentMutedBrush}"
                BorderBrush="{DynamicResource TorenAccentBrush}" BorderThickness="1">
          <TextBlock Text="T" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource TorenAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                     Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding Description}" Classes="muted"
                 FontSize="13" TextWrapping="Wrap" />
      <Border Height="1" Background="{DynamicResource TorenBorderBrush}" />
      <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto" RowSpacing="11">
        <TextBlock Text="License" Classes="section-label" />
        <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="12" />
        <TextBlock Grid.Row="1" Text="Source" Classes="section-label" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Repository}"
                   Classes="muted" FontSize="12" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="2" Background="{DynamicResource TorenSurfaceBrush}"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0"
            Padding="18,0">
      <Button Classes="toolbar-button outline-action" HorizontalAlignment="Right"
              VerticalAlignment="Center" MinWidth="96" IsCancel="True"
              Click="CloseWindow_OnClick" AutomationProperties.Name="Close About window">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconClose}"
                Width="14" Height="14" />
          <TextBlock Text="Close" />
        </StackPanel>
      </Button>
    </Border>
  </Grid>
</Window>
