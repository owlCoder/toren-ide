<Window x:Class="Toren.App.Views.AboutWindow"
        x:ClassModifier="internal"
        x:DataType="vm:AboutWindowViewModel"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:brand="clr-namespace:Toren.App.Views.Brand"
        xmlns:vm="clr-namespace:Toren.App.ViewModels"
        Width="500" Height="340" CanResize="False"
        WindowDecorations="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="About Toren IDE">
  <Border BorderBrush="{DynamicResource TorenBorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource TorenCardRadius}" Margin="4" ClipToBounds="True">
    <Grid RowDefinitions="46,*">
      <Border Classes="title-bar" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <Border Padding="16,0" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="shell-icon" Data="{StaticResource TorenIconWelcome}" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" /><TextBlock Text="About Toren IDE" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Button Grid.Column="1" Classes="window-control close" Width="34" Height="34" Margin="6" Click="CloseWindow_OnClick" ToolTip.Tip="Close" AutomationProperties.Name="Close About window"><Path Classes="shell-icon" Data="{StaticResource TorenIconClose}" Width="14" Height="14" /></Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="20,18" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
          <brand:BrandMark Width="56" Height="56" Margin="-4" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Classes="muted" FontSize="12" /></StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
        <Border Grid.Row="2" Classes="panel-card" Padding="12" VerticalAlignment="Top">
          <Grid ColumnDefinitions="18,66,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="12">
            <Path Classes="shell-icon" Data="{StaticResource TorenIconCheck}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="License" Classes="field-label" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding License}" FontSize="12" />
            <Path Grid.Row="1" Classes="shell-icon" Data="{StaticResource TorenIconSourceControl}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Source" Classes="field-label" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Repository}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
