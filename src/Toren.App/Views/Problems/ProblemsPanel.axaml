<UserControl x:Class="Toren.App.Views.Problems.ProblemsPanel"
             x:ClassModifier="internal"
             x:DataType="vm:MainWindowViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toren.App.ViewModels"
             xmlns:diagvm="clr-namespace:Toren.App.Diagnostics.ViewModels">
  <UserControl.Styles>
    <Style Selector="ToggleButton.problem-filter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.problem-filter:pointerover">
      <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.problem-filter:checked">
      <Setter Property="Background" Value="{DynamicResource TorenSurfaceSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            IsVisible="{Binding Problems.HasAnyProblems}"
            BorderBrush="{DynamicResource TorenBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,5">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <ToggleButton Classes="problem-filter"
                        IsChecked="{Binding Problems.ShowErrors}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenErrorBrush}" />
              <TextBlock Text="Errors" FontSize="10.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Problems.ErrorCount}" FontSize="10.5"
                         Foreground="{DynamicResource TorenTextSubtleBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="problem-filter"
                        IsChecked="{Binding Problems.ShowWarnings}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenWarningBrush}" />
              <TextBlock Text="Warnings" FontSize="10.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Problems.WarningCount}" FontSize="10.5"
                         Foreground="{DynamicResource TorenTextSubtleBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="problem-filter"
                        IsChecked="{Binding Problems.ShowInfo}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenAccentBrush}" />
              <TextBlock Text="Info" FontSize="10.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Problems.InfoCount}" FontSize="10.5"
                         Foreground="{DynamicResource TorenTextSubtleBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
          <TextBlock Text="Scope" FontSize="10.5"
                     Foreground="{DynamicResource TorenTextSubtleBrush}"
                     VerticalAlignment="Center" Margin="0,0,3,0" />
          <ToggleButton Classes="problem-filter"
                        Content="Workspace"
                        ToolTip.Tip="Show problems from the entire workspace"
                        IsChecked="{Binding Problems.IsWorkspaceScope}" />
          <ToggleButton Classes="problem-filter"
                        Content="Project"
                        ToolTip.Tip="{Binding Problems.ProjectScopeName}"
                        IsEnabled="{Binding Problems.CanUseProjectScope}"
                        IsChecked="{Binding Problems.IsProjectScope}" />
          <ToggleButton Classes="problem-filter"
                        Content="File"
                        ToolTip.Tip="Show problems from the current document"
                        IsEnabled="{Binding Problems.CanUseCurrentDocumentScope}"
                        IsChecked="{Binding Problems.IsCurrentDocumentScope}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <StackPanel Margin="17,14" Spacing="6" IsVisible="{Binding Problems.IsEmpty}">
        <TextBlock Text="No problems to show" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Classes="muted" Text="C# diagnostics update as you edit." FontSize="11" />
      </StackPanel>

      <StackPanel Margin="17,14" Spacing="6" IsVisible="{Binding Problems.IsFilteredEmpty}">
        <TextBlock Text="No problems match the current filters" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Classes="muted" Text="Enable a severity filter above to show hidden diagnostics." FontSize="11" />
      </StackPanel>

      <ListBox x:Name="ProblemsList"
               Classes="problems-list"
               ItemsSource="{Binding Problems.Items}"
               IsVisible="{Binding Problems.HasItems}"
               DoubleTapped="ProblemsList_OnDoubleTapped"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="diagvm:ProblemItemViewModel">
            <Grid Height="30" Margin="10,0,14,0"
                  ColumnDefinitions="12,Auto,*,Auto,Auto" ColumnSpacing="9">
              <Grid Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenErrorBrush}"
                         IsVisible="{Binding IsError}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenWarningBrush}"
                         IsVisible="{Binding IsWarning}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource TorenAccentBrush}"
                         IsVisible="{Binding IsInfo}" />
              </Grid>
              <TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="11"
                         FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                         Foreground="{DynamicResource TorenTextMutedBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="subtle" Text="{Binding FileName}"
                         FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Classes="subtle" Text="{Binding Location}"
                         FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
