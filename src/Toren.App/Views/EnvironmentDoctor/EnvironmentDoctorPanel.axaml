<UserControl x:Class="Toren.App.Views.EnvironmentDoctor.EnvironmentDoctorPanel"
             x:ClassModifier="internal"
             x:DataType="doctorvm:EnvironmentDoctorViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:doctorvm="clr-namespace:Toren.App.EnvironmentDoctor.ViewModels"
             xmlns:doctor="clr-namespace:Toren.App.EnvironmentDoctor.Models">
  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="10,8">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconDoctor}" /><TextBlock Classes="panel-heading" Text="Environment Doctor" /></StackPanel>
        <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-button compact-action icon-refresh" Content="Refresh"
              Click="Refresh_OnClick" IsEnabled="{Binding CanRefresh}" />
    </Grid>

    <ListBox Grid.Row="1" ItemsSource="{Binding Checks}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="doctor:EnvironmentDoctorCheck">
          <Border Classes="panel-card" Margin="0,0,0,6" Padding="10">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap" ToolTip.Tip="{Binding DisplayName}" />
                <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding Status}" FontSize="11" />
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Classes="subtle" Text="{Binding Remediation}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
