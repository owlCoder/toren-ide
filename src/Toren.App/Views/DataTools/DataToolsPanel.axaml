<UserControl x:Class="Toren.App.Views.DataTools.DataToolsPanel"
             x:ClassModifier="internal"
             x:DataType="datavm:DataToolsViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:datavm="clr-namespace:Toren.App.DataTools.ViewModels"
             xmlns:ef="clr-namespace:Toren.DotNet.EntityFramework.Models;assembly=Toren.DotNet">
  <Grid ColumnDefinitions="*,*">
    <Border Grid.Column="0" Padding="10,8"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="7">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="EF Core" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="{Binding EfStatusText}" FontSize="11"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="toolbar-button" Content="Refresh"
                  Click="RefreshEf_OnClick" IsEnabled="{Binding CanUseEf}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding NewMigrationName, Mode=TwoWay}"
                   PlaceholderText="Migration name" />
          <TextBox Grid.Column="1" Text="{Binding MigrationOutputDirectory, Mode=TwoWay}"
                   PlaceholderText="Output folder" AutomationProperties.Name="Migration output directory"
                   ToolTip.Tip="Optional migration output directory" />
          <Button Grid.Column="2" Classes="toolbar-button" Content="Add"
                  Click="AddMigration_OnClick" IsEnabled="{Binding CanAddMigration}" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Migrations}"
                 SelectedIndex="{Binding SelectedMigrationIndex, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ef:EfCoreMigrationInfo">
              <Grid Margin="6,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="subtle" FontSize="11"
                           Text="{Binding Applied}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Classes="toolbar-button" Content="Remove Latest Migration"
                HorizontalAlignment="Right" Click="RemoveMigration_OnClick"
                IsEnabled="{Binding CanUseEf}" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding DatabaseTarget, Mode=TwoWay}"
                   PlaceholderText="Target migration" AutomationProperties.Name="Database target migration"
                   ToolTip.Tip="Leave empty to update to the latest migration" />
          <Button Grid.Column="1" Classes="toolbar-button" Content="Update Database"
                  Click="UpdateDatabase_OnClick" IsEnabled="{Binding CanUseEf}" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="10,8" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
      <StackPanel Grid.Row="0" Spacing="3">
        <TextBlock Text="Docker Compose" FontSize="11" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{Binding DockerStatusText}" FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Grid.Column="0" Text="{Binding ComposeFilePath, Mode=TwoWay}"
                 PlaceholderText="Compose file path" />
        <Button Grid.Column="1" Classes="toolbar-button" Content="Detect"
                Click="RefreshDocker_OnClick" />
      </Grid>

      <WrapPanel Grid.Row="2" Classes="tool-actions">
        <Button Classes="toolbar-button" Content="Up" Click="Up_OnClick"
                IsEnabled="{Binding CanUseDocker}" />
        <Button Classes="toolbar-button" Content="Down" Click="Down_OnClick"
                IsEnabled="{Binding CanUseDocker}" />
        <Button Classes="toolbar-button" Content="Build" Click="Build_OnClick"
                IsEnabled="{Binding CanUseDocker}" />
        <Button Classes="toolbar-button" Content="Logs" Click="Logs_OnClick"
                IsEnabled="{Binding CanUseDocker}" />
      </WrapPanel>

      <TextBox Grid.Row="3" Text="{Binding DockerLogs}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="NoWrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono, Menlo, Consolas, monospace"
               FontSize="11" />
    </Grid>
  </Grid>
</UserControl>
