<UserControl x:Class="Toren.App.Views.Terminal.TerminalPanel"
             x:ClassModifier="internal"
             x:DataType="terminalvm:TerminalHostViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terminalvm="clr-namespace:Toren.App.Terminal.ViewModels">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="10,6"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" Data="{StaticResource TorenIconTerminal}" /><TextBlock Classes="panel-heading" Text="Terminal" /></StackPanel>
        <Button Grid.Column="1" Classes="toolbar-button compact-action icon-add" Content="New" ToolTip.Tip="New terminal session"
                Click="NewSession_OnClick" />
        <Button Grid.Column="2" Classes="toolbar-button compact-action icon-delete icon-only" Content="Close" ToolTip.Tip="Close selected terminal session" AutomationProperties.Name="Close terminal session"
                IsEnabled="{Binding CanCloseSession}" Click="CloseSession_OnClick" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="10,6"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="160,*,Auto,Auto,Auto" ColumnSpacing="6">
        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Sessions}"
                  SelectedIndex="{Binding SelectedSessionIndex, Mode=TwoWay}" AutomationProperties.Name="Terminal session">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="terminalvm:TerminalViewModel">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock Classes="muted" Text="{Binding SelectedSession.StatusText}" FontSize="11"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSession.StatusText}" />
          <TextBlock Classes="muted" Text="{Binding SelectedSession.WorkingDirectory}" FontSize="11"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSession.WorkingDirectory}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="toolbar-button compact-action icon-run icon-only" Content="Start" ToolTip.Tip="Start terminal process" AutomationProperties.Name="Start terminal process"
                IsEnabled="{Binding SelectedSession.CanStart}" Click="Start_OnClick" />
        <Button Grid.Column="3" Classes="toolbar-button compact-action icon-stop" Content="Kill"
                ToolTip.Tip="Kill the terminal process and its children"
                AutomationProperties.Name="Kill terminal process"
                IsEnabled="{Binding SelectedSession.CanStop}" Click="Stop_OnClick" />
        <Button Grid.Column="4" Classes="toolbar-button compact-action icon-delete icon-only" Content="Clear" ToolTip.Tip="Clear terminal output" AutomationProperties.Name="Clear terminal output"
                IsEnabled="{Binding SelectedSession.HasOutput}" Click="Clear_OnClick" />
      </Grid>
    </Border>

    <ListBox Grid.Row="2" ItemsSource="{Binding SelectedSession.Lines}" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="terminalvm:TerminalLineViewModel">
          <TextBlock Margin="10,2" Text="{Binding Text}" FontSize="11"
                     FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                     TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="3" Margin="10,7" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
      <TextBlock Grid.Column="0" Text="$" FontSize="12" Foreground="{DynamicResource TorenAccentBrush}"
                 FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                 VerticalAlignment="Center" />
      <TextBox x:Name="TerminalInput" Grid.Column="1" PlaceholderText="Enter command"
               Text="{Binding SelectedSession.InputText, Mode=TwoWay}"
               IsEnabled="{Binding SelectedSession.IsRunning}" KeyDown="Command_OnKeyDown"
               FontFamily="Cascadia Code, Menlo, Consolas, monospace" />
      <Button Grid.Column="2" Classes="primary-action compact-action icon-run" Content="Run"
              IsEnabled="{Binding SelectedSession.CanSubmit}" Click="Submit_OnClick" />
    </Grid>
  </Grid>
</UserControl>
