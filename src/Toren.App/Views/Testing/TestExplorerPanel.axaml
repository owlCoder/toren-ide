<UserControl x:Class="Toren.App.Views.Testing.TestExplorerPanel"
             x:ClassModifier="internal"
             x:DataType="testvm:TestExplorerViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:testvm="clr-namespace:Toren.App.Testing.ViewModels"
             xmlns:testmodels="clr-namespace:Toren.App.Testing.Models"
             xmlns:dotnettests="clr-namespace:Toren.DotNet.Testing.Models;assembly=Toren.DotNet">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Classes="panel-header">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="6" RowSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconTests}" /><TextBlock Classes="panel-heading" Text="Tests" /></StackPanel>
        <Button Classes="toolbar-button compact-action icon-refresh icon-only" Content="Refresh" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh" x:Name="RefreshTestsButton" Grid.Column="1" IsEnabled="{Binding !IsRunning}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="10,8"
            BorderBrush="{DynamicResource TorenBorderBrush}"
            BorderThickness="0,0,0,1">
      <WrapPanel Classes="tool-actions">
        <Button Classes="primary-action compact-action icon-run" Content="Run All"
                Click="RunAll_OnClick" IsEnabled="{Binding CanRunAll}" />
        <Button Classes="toolbar-button compact-action icon-refresh" Content="Rerun Failed" ToolTip.Tip="Rerun failed projects"
                Click="RerunFailedProjects_OnClick"
                IsEnabled="{Binding CanRerunFailedProjects}" />
        <Button Classes="toolbar-button compact-action icon-stop" Content="Stop"
                Click="Stop_OnClick" IsEnabled="{Binding CanStop}" />
        <Button Classes="toolbar-button compact-action icon-delete" Content="Clear Output"
                Click="ClearOutput_OnClick" IsEnabled="{Binding HasOutput}" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="*,Auto">
      <Grid Grid.Row="0">
        <StackPanel Margin="12" Spacing="5" IsVisible="{Binding IsLoading}">
          <TextBlock Text="Discovering tests…" FontWeight="SemiBold" FontSize="11.5" />
          <ProgressBar IsIndeterminate="True" Height="3" />
        </StackPanel>

        <StackPanel Margin="12" Spacing="5" IsVisible="{Binding IsEmpty}">
          <TextBlock Text="No tests discovered" FontWeight="SemiBold" FontSize="11.5" />
          <TextBlock Classes="muted" Text="Open a workspace with a test project, then refresh discovery."
                     FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer IsVisible="{Binding HasProjects}">
          <ItemsControl ItemsSource="{Binding Projects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="testmodels:WorkspaceTestProjectDiscovery">
                <Border Classes="panel-card" Margin="10,6">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                               FontWeight="SemiBold" FontSize="11"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ProjectPath}" />
                    <Border Grid.Column="1" Classes="status-badge"><TextBlock Text="{Binding Tests.Count}" Foreground="{DynamicResource TorenAccentBrush}" FontSize="11" /></Border>
                  </Grid>
                  <TextBlock IsVisible="{Binding ErrorMessage}" Text="{Binding ErrorMessage}"
                             Foreground="{DynamicResource TorenErrorBrush}"
                             FontSize="11" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Tests}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dotnettests:DotNetTestCase">
                        <Grid Margin="6,4,0,6" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" RowSpacing="3">
                          <TextBlock Grid.ColumnSpan="3" Text="{Binding DisplayName}"
                                     FontSize="11" TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding FullyQualifiedName}" />
                          <Button Grid.Row="1" Grid.Column="0"
                                  IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.CanRunAll}"
                                  Content="Run" Classes="toolbar-button compact-action icon-run" Click="RunTest_OnClick"
                                  Padding="6,1" FontSize="11" />
                          <Button Grid.Row="1" Grid.Column="1"
                                  IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.CanDebug}"
                                  Content="Debug" Classes="toolbar-button compact-action icon-debug" Click="DebugTest_OnClick"
                                  ToolTip.Tip="Start the selected test and wait for debugger attach"
                                  Padding="6,1" FontSize="11" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="1" MaxHeight="190" IsVisible="{Binding HasOutput}"
              BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0">
        <ListBox ItemsSource="{Binding OutputLines}"
                 DoubleTapped="TestOutputList_OnDoubleTapped"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="testvm:TestRunOutputLineViewModel">
              <Grid Margin="8,2">
                <TextBlock Text="{Binding Text}" IsVisible="{Binding IsStandardOutput}"
                           FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                           FontSize="11" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Text}" IsVisible="{Binding IsStandardError}"
                           Foreground="{DynamicResource TorenErrorBrush}"
                           FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                           FontSize="11" TextWrapping="NoWrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </Grid>
</UserControl>
