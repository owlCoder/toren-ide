<UserControl x:Class="Toren.App.Views.Packages.PackageManagerPanel"
             x:ClassModifier="internal"
             x:DataType="pkgvm:PackageManagerViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pkgvm="clr-namespace:Toren.App.Packages.ViewModels"
             xmlns:pkg="clr-namespace:Toren.DotNet.Packages.Models;assembly=Toren.DotNet">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="10,7"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="6">
        <TextBlock Grid.Column="0" Text="Project target" FontSize="11" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"
                  PlaceholderText="Select project" ItemsSource="{Binding Projects}"
                  SelectedIndex="{Binding SelectedProjectIndex, Mode=TwoWay}"
                  SelectionChanged="Project_OnSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="pkgvm:PackageProjectTarget">
              <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Path}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="muted" Text="{Binding StatusText}"
                   FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusText}" />
        <Button Grid.Column="2" Classes="toolbar-button compact-action icon-refresh icon-only" Content="Refresh Installed" ToolTip.Tip="Refresh installed packages" AutomationProperties.Name="Refresh installed packages"
                Click="RefreshInstalled_OnClick" IsEnabled="{Binding CanManagePackages}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="8,7"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="7" RowSpacing="6">
        <TextBox x:Name="PackageSearchBox" Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                 IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Search NuGet packages"
                 PlaceholderText="Search NuGet packages" KeyDown="SearchBox_OnKeyDown" />
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CustomSource, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}"
                 PlaceholderText="Custom feed URL (optional)"
                 ToolTip.Tip="Leave empty to use configured NuGet sources" />
        <CheckBox Grid.Row="1" Grid.Column="1" Content="Prerelease" IsChecked="{Binding IncludePrerelease}" IsEnabled="{Binding !IsBusy}"
                  VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary-action compact-action icon-search" Content="Search"
                Click="Search_OnClick" IsEnabled="{Binding CanSearch}" />
        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsBusy}" IsIndeterminate="True"
                     Height="3" MinHeight="0" Foreground="{DynamicResource TorenAccentBrush}"
                     AutomationProperties.Name="Package operation progress" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="10,8">
      <Border Grid.Column="0" Classes="panel-card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="8,7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconSearch}" /><TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Search Results" /></StackPanel>
            <Button Grid.Column="1" Classes="toolbar-button compact-action icon-add" Content="Install"
                    Click="Install_OnClick" IsEnabled="{Binding CanInstallSelected}" />
          </Grid>
          <TextBlock Grid.Row="1" Margin="16,12" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     Text="Search for a package to see available versions."
                     IsVisible="{Binding !SearchResults.Count}" />
          <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" IsVisible="{Binding SearchResults.Count}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectedIndex="{Binding SelectedSearchResultIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pkg:NuGetPackageSearchResult">
                <StackPanel Margin="4,5" Spacing="4">
                  <TextBlock Text="{Binding Id}" ToolTip.Tip="{Binding Id}" FontSize="11"
                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding LatestVersion}" ToolTip.Tip="{Binding LatestVersion}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" FontSize="11"
                             Text="{Binding SourceName}" ToolTip.Tip="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel-card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="8,7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconProject}" /><TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="Installed" /></StackPanel>
            <Button Grid.Column="1" Classes="toolbar-button compact-action icon-refresh" Content="Update"
                    Click="Update_OnClick" IsEnabled="{Binding CanUpdateSelected}" />
            <Button Grid.Column="2" Classes="toolbar-button compact-action icon-delete" Content="Remove"
                    Click="Remove_OnClick" IsEnabled="{Binding CanRemoveSelected}" />
          </Grid>
          <TextBlock Grid.Row="1" Margin="16,12" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     Text="Select a project to inspect its package references."
                     IsVisible="{Binding !InstalledPackages.Count}" />
          <ListBox Grid.Row="1" ItemsSource="{Binding InstalledPackages}" IsVisible="{Binding InstalledPackages.Count}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectedIndex="{Binding SelectedInstalledPackageIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pkg:NuGetInstalledPackage">
                <StackPanel Margin="4,5" Spacing="4">
                  <TextBlock Text="{Binding Id}" ToolTip.Tip="{Binding Id}" FontSize="11"
                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ResolvedVersion}" ToolTip.Tip="{Binding ResolvedVersion}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" FontSize="11"
                             Text="{Binding TargetFramework}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Classes="subtle" Margin="9,5" FontSize="11" TextWrapping="Wrap"
               Text="Install, update or remove packages for the selected project." />
  </Grid>
</UserControl>
