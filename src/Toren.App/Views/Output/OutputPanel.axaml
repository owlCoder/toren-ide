<UserControl x:Class="Toren.App.Views.Output.OutputPanel"
             x:ClassModifier="internal"
             x:DataType="execvm:WorkspaceExecutionViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:execvm="clr-namespace:Toren.App.Execution.ViewModels"
             xmlns:execmodels="clr-namespace:Toren.App.Execution.Models"
             xmlns:dotnetmodels="clr-namespace:Toren.DotNet.Execution.Models;assembly=Toren.DotNet">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource TorenBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <StackPanel Spacing="6">
        <WrapPanel Classes="tool-actions">
          <ComboBox Width="92"
                    SelectedIndex="{Binding ConfigurationIndex}"
                    IsEnabled="{Binding CanExecute}"
                    ToolTip.Tip="Build configuration">
            <ComboBoxItem Content="Debug" />
            <ComboBoxItem Content="Release" />
          </ComboBox>
          <ComboBox Width="170"
                    PlaceholderText="Startup project"
                    ItemsSource="{Binding RunTargets}"
                    SelectedIndex="{Binding SelectedRunTargetIndex}"
                    IsEnabled="{Binding CanExecute}"
                    ToolTip.Tip="Startup project">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="execmodels:WorkspaceExecutionTarget">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="125"
                    PlaceholderText="Framework"
                    ItemsSource="{Binding TargetFrameworks}"
                    SelectedIndex="{Binding SelectedTargetFrameworkIndex}"
                    IsEnabled="{Binding CanExecute}"
                    ToolTip.Tip="Target framework" />
          <ComboBox Width="130"
                    PlaceholderText="Launch profile"
                    ItemsSource="{Binding LaunchProfiles}"
                    SelectedIndex="{Binding SelectedLaunchProfileIndex}"
                    IsEnabled="{Binding CanExecute}"
                    ToolTip.Tip="Launch profile">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dotnetmodels:DotNetLaunchProfile">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </WrapPanel>
        <WrapPanel Classes="tool-actions">
          <Button Classes="toolbar-button compact-action icon-fetch" Content="Restore" ToolTip.Tip="Restore" AutomationProperties.Name="Restore" Click="Restore_OnClick"
                  IsEnabled="{Binding CanExecute}" />
          <Button Classes="primary-action compact-action icon-package" Content="Build" ToolTip.Tip="Build" AutomationProperties.Name="Build" Click="Build_OnClick"
                  IsEnabled="{Binding CanExecute}" />
          <Button Classes="toolbar-button compact-action icon-refresh icon-only" Content="Rebuild" ToolTip.Tip="Rebuild solution" AutomationProperties.Name="Rebuild solution" Click="Rebuild_OnClick"
                  IsEnabled="{Binding CanExecute}" />
          <Button Classes="toolbar-button compact-action icon-delete icon-only" Content="Clean" ToolTip.Tip="Clean solution" AutomationProperties.Name="Clean solution" Click="Clean_OnClick"
                  IsEnabled="{Binding CanExecute}" />
          <Button Classes="toolbar-button compact-action icon-push" Content="Publish" ToolTip.Tip="Publish" AutomationProperties.Name="Publish" Click="Publish_OnClick"
                  IsEnabled="{Binding CanExecute}" />
          <Button Classes="primary-action compact-action icon-run" Content="Run" ToolTip.Tip="Run" AutomationProperties.Name="Run" Click="Run_OnClick"
                  IsEnabled="{Binding CanRun}" />
          <Button Classes="toolbar-button compact-action icon-stop icon-only" Content="Cancel" ToolTip.Tip="Cancel current command" AutomationProperties.Name="Cancel current command" Click="Cancel_OnClick"
                  IsEnabled="{Binding CanCancel}" />
          <Button Classes="toolbar-button compact-action icon-delete icon-only" Content="Clear" ToolTip.Tip="Clear output" AutomationProperties.Name="Clear output" Click="Clear_OnClick"
                  IsEnabled="{Binding HasOutput}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <StackPanel Margin="17,14" Spacing="6" IsVisible="{Binding IsOutputEmpty}">
        <TextBlock Text="No output yet" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Classes="muted" Text="Build or run your workspace to see output. F5 runs the startup project; Shift+F5 stops it."
                   FontSize="11" TextWrapping="Wrap" />
      </StackPanel>

      <ListBox ItemsSource="{Binding OutputLines}"
               IsVisible="{Binding HasOutput}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="execvm:ExecutionOutputLineViewModel">
            <Grid Margin="12,2">
              <TextBlock Text="{Binding Text}"
                         IsVisible="{Binding IsStandardOutput}"
                         FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                         FontSize="11" TextWrapping="NoWrap" />
              <TextBlock Text="{Binding Text}"
                         IsVisible="{Binding IsStandardError}"
                         Foreground="{DynamicResource TorenErrorBrush}"
                         FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                         FontSize="11" TextWrapping="NoWrap" />
              <TextBlock Text="{Binding Text}"
                         IsVisible="{Binding IsCommand}"
                         Foreground="{DynamicResource TorenAccentBrush}"
                         FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                         FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
              <TextBlock Text="{Binding Text}"
                         IsVisible="{Binding IsStatus}"
                         Foreground="{DynamicResource TorenTextMutedBrush}"
                         FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                         FontSize="11" FontStyle="Italic" TextWrapping="NoWrap" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <TextBlock Grid.Row="2" Classes="subtle" Text="{Binding StatusText}"
               Margin="12,4" FontSize="11" TextTrimming="CharacterEllipsis"
               ToolTip.Tip="{Binding StatusText}" />
  </Grid>
</UserControl>
