<UserControl x:Class="Toren.App.Views.Settings.ApplicationSettingsPanel"
             x:ClassModifier="internal"
             x:DataType="settingsvm:ApplicationSettingsViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsvm="clr-namespace:Toren.App.Settings.ViewModels"
             AutomationProperties.Name="Application settings">
  <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="16,12">
    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconSettings}" /><TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="Preferences" /></StackPanel>
      <TextBox x:Name="SettingsSearchBox"
               Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search settings"
               AutomationProperties.Name="Search settings"
               AutomationProperties.HelpText="Filter settings by name or category" />
      <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                 AutomationProperties.Name="Settings status" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" AutomationProperties.Name="Settings categories">
      <StackPanel Spacing="10">
        <Border Classes="card" IsVisible="{Binding ShowAppearanceSection}" Padding="14,12">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
            <Grid Grid.Row="0" ColumnDefinitions="30,*" ColumnSpacing="10">
              <Border Classes="icon-badge"><Path Classes="shell-icon" Data="{StaticResource TorenIconPalette}" /></Border>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Theme changes apply immediately and are persisted locally." FontSize="11" TextWrapping="Wrap" /></StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="140,*" ColumnSpacing="10">
              <TextBlock Text="Color theme" VerticalAlignment="Center" FontSize="11" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Color theme"
                        AutomationProperties.HelpText="Choose the Toren IDE light or dark color theme">
                <ComboBoxItem Content="Dark" />
                <ComboBoxItem Content="Light" />
              </ComboBox>
            </Grid>
          </Grid>
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowEditorSection}" Padding="14,12">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="30,*" ColumnSpacing="10">
              <Border Classes="icon-badge"><Path Classes="shell-icon" Data="{StaticResource TorenIconCodeFile}" /></Border>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Editor" FontSize="13" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Changes apply to the active editor immediately." FontSize="11" TextWrapping="Wrap" /></StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
              <TextBlock Text="Font size" VerticalAlignment="Center" FontSize="11" />
              <Slider Grid.Column="1" Minimum="8" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding EditorFontSize, Mode=TwoWay}"
                      AutomationProperties.Name="Editor font size"
                      AutomationProperties.HelpText="Editor font size from 8 to 40" />
              <TextBlock Grid.Column="2" Classes="muted" Text="{Binding EditorFontSize, StringFormat={}{0:0} px}"
                         FontSize="11" MinWidth="34" VerticalAlignment="Center" />
            </Grid>
            <CheckBox Grid.Row="2" Content="Show line numbers"
                      IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"
                      AutomationProperties.Name="Show line numbers" />
            <CheckBox Grid.Row="3" Content="Word wrap"
                      IsChecked="{Binding WordWrap, Mode=TwoWay}"
                      AutomationProperties.Name="Word wrap" />
          </Grid>
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowKeyboardSection}" Padding="14,12">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="30,*" ColumnSpacing="10">
              <Border Classes="icon-badge"><Path Classes="shell-icon" Data="{StaticResource TorenIconKeyboard}" /></Border>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Keyboard" FontSize="13" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Core shell shortcuts can be changed without restarting Toren IDE." FontSize="11" TextWrapping="Wrap" /></StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="140,*" ColumnSpacing="10">
              <TextBlock Text="Save active document" VerticalAlignment="Center" FontSize="11" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SaveKeybindingIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Save active document shortcut">
                <ComboBoxItem Content="Ctrl/Cmd+S" />
                <ComboBoxItem Content="Ctrl/Cmd+Shift+S" />
                <ComboBoxItem Content="Alt+S" />
              </ComboBox>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="140,*" ColumnSpacing="10">
              <TextBlock Text="Open Settings" VerticalAlignment="Center" FontSize="11" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding OpenSettingsKeybindingIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Open Settings shortcut">
                <ComboBoxItem Content="Ctrl/Cmd+Alt+S" />
                <ComboBoxItem Content="Ctrl/Cmd+Alt+Shift+S" />
                <ComboBoxItem Content="F12" />
              </ComboBox>
            </Grid>
          </Grid>
        </Border>

        <TextBlock IsVisible="{Binding !HasSearchResults}" Classes="muted"
                   Text="No settings match your search." FontSize="11"
                   AutomationProperties.Name="No settings match your search" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
