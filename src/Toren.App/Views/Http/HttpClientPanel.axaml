<UserControl x:Class="Toren.App.Views.Http.HttpClientPanel"
             x:ClassModifier="internal"
             x:DataType="httpvm:HttpClientViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:httpvm="clr-namespace:Toren.App.Http.ViewModels"
             xmlns:http="clr-namespace:Toren.DotNet.Http.Models;assembly=Toren.DotNet">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="9,7"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Request" FontSize="10.5" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Requests}"
                  SelectedIndex="{Binding SelectedRequestIndex, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="http:HttpRequestDefinition">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <TextBlock Grid.Column="0" Text="{Binding Method}" FontSize="10" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding RequestTarget}" FontSize="10"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Classes="toolbar-button" Content="Send"
                Click="Send_OnClick" IsEnabled="{Binding CanSend}" />
        <Button Grid.Column="3" Classes="toolbar-button" Content="Cancel"
                Click="Cancel_OnClick" IsEnabled="{Binding CanCancel}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="8,7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="History" FontSize="10.5" FontWeight="SemiBold" />
            <Button Grid.Column="1" Classes="toolbar-button" Content="Clear"
                    Click="ClearHistory_OnClick" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding History}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="http:HttpRequestHistoryEntry">
                <Grid Margin="8,5" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="10"
                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusCode}" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" FontSize="9.5"
                             Text="{Binding RequestTarget}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="9,7"
                BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="{Binding ResponseStatus}" FontSize="10.5" FontWeight="SemiBold" />
        </Border>
        <TextBox Grid.Row="1" Margin="8,7,8,0" MinHeight="54" MaxHeight="110"
                 Text="{Binding ResponseHeaders}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                 PlaceholderText="Response headers" />
        <TextBox Grid.Row="2" Margin="8" Text="{Binding ResponseBody}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Menlo, Consolas, monospace" PlaceholderText="Response body" />
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Classes="subtle" Margin="9,5" FontSize="9.5"
               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
