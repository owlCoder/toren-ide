<Window
    x:Class="Toren.App.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Toren.App.ViewModels"
    Width="1440"
    Height="900"
    MinWidth="1080"
    MinHeight="700"
    Title="Toren IDE">

  <Grid RowDefinitions="50,*,176,26" ColumnDefinitions="50,280,*">
    <!-- Command bar -->
    <Border
        Grid.Row="0"
        Grid.ColumnSpan="3"
        Classes="shell-surface"
        BorderThickness="0,0,0,1">
      <Grid Margin="10,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border
              Width="30"
              Height="30"
              Background="{DynamicResource TorenAccentMutedBrush}"
              BorderBrush="{DynamicResource TorenAccentBrush}"
              BorderThickness="1"
              CornerRadius="7">
            <TextBlock
                Text="T"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource TorenAccentBrush}" />
          </Border>
          <TextBlock Text="Toren IDE" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="toolbar-button" Content="Open Folder" Click="OpenFolder_OnClick" />
          <Button Classes="toolbar-button" Content="Open Solution" Click="OpenWorkspaceFile_OnClick" />
        </StackPanel>

        <TextBlock
            Grid.Column="2"
            Text="{Binding WorkspaceTitle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="subtle"
            FontSize="11" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="card" Padding="9,5">
            <TextBlock Classes="muted" Text="{Binding SdkSummary}" FontSize="11" />
          </Border>
          <Button Classes="toolbar-button" Content="?" Width="32" Padding="0" Click="About_OnClick" ToolTip.Tip="About Toren IDE" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Activity bar -->
    <Border
        Grid.Row="1"
        Grid.RowSpan="2"
        Grid.Column="0"
        Classes="shell-surface"
        BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Button Grid.Row="0" Classes="activity-button active" Content="▤" ToolTip.Tip="Explorer" />
        <Button Grid.Row="1" Classes="activity-button" Content="⑂" ToolTip.Tip="Source Control — planned for MVP 1.0" IsEnabled="False" />
        <Button Grid.Row="2" Classes="activity-button" Content="✓" ToolTip.Tip="Tests — planned for MVP 1.0" IsEnabled="False" />
        <Button Grid.Row="3" Classes="activity-button" Content="▷" ToolTip.Tip="Debug — planned for MVP 1.0" IsEnabled="False" />
        <Button Grid.Row="5" Classes="activity-button" Content="⚙" ToolTip.Tip="Settings — planned for MVP 1.0" IsEnabled="False" />
      </Grid>
    </Border>

    <!-- Explorer -->
    <Border
        Grid.Row="1"
        Grid.RowSpan="2"
        Grid.Column="1"
        Classes="shell-surface"
        BorderThickness="0,0,1,0">
      <Grid RowDefinitions="42,Auto,*,Auto">
        <Border Padding="14,0" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Classes="tool-title" Text="EXPLORER" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1" Margin="14,14,14,8" Spacing="5">
          <TextBlock Text="{Binding WorkspaceTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding WorkspacePath}" FontSize="11" TextWrapping="Wrap" MaxLines="3" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="14,12" Spacing="12" VerticalAlignment="Top">
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="Start a workspace" FontWeight="SemiBold" FontSize="13" />
              <TextBlock
                  Classes="muted"
                  Text="Open a standard .NET folder, solution, or project. Toren never converts your project into a proprietary format."
                  FontSize="11"
                  TextWrapping="Wrap" />
              <Button Classes="primary-action" Content="Open Folder" HorizontalAlignment="Stretch" Click="OpenFolder_OnClick" />
              <Button Classes="toolbar-button" Content="Open Solution or Project" HorizontalAlignment="Stretch" Click="OpenWorkspaceFile_OnClick" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="3" Padding="14,10" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0">
          <TextBlock Classes="subtle" Text=".sln  ·  .slnx  ·  .csproj" FontSize="10" />
        </Border>
      </Grid>
    </Border>

    <!-- Document area -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="38,*">
      <Border
          Grid.Row="0"
          Background="{DynamicResource TorenSurfaceBrush}"
          BorderBrush="{DynamicResource TorenBorderBrush}"
          BorderThickness="0,0,0,1">
        <Border
            MinWidth="126"
            HorizontalAlignment="Left"
            Padding="14,0"
            Background="{DynamicResource TorenBackgroundBrush}"
            BorderBrush="{DynamicResource TorenAccentBrush}"
            BorderThickness="0,0,0,2">
          <TextBlock Text="Welcome" FontSize="12" VerticalAlignment="Center" />
        </Border>
      </Border>

      <Grid Grid.Row="1" Background="{DynamicResource TorenBackgroundBrush}">
        <StackPanel
            Width="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Text="Toren IDE" FontSize="32" FontWeight="SemiBold" />
            <TextBlock
                Classes="muted"
                Text="Modern .NET development without project lock-in."
                FontSize="15" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary-action" Content="Open Folder" Click="OpenFolder_OnClick" />
            <Button Classes="toolbar-button" Content="Open Solution or Project" Click="OpenWorkspaceFile_OnClick" />
          </StackPanel>

          <Grid Margin="0,8,0,0" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="CURRENT SESSION" />
                <TextBlock Text="{Binding EditorText}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="PROJECT COMPATIBILITY" />
                <TextBlock
                    Text="Standard .NET projects stay compatible with the dotnet CLI, Visual Studio, Rider, and VS Code."
                    Classes="muted"
                    FontSize="12"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Bottom tool window -->
    <Border
        Grid.Row="2"
        Grid.Column="2"
        Classes="shell-surface"
        BorderThickness="0,1,0,0">
      <Grid RowDefinitions="36,*">
        <StackPanel Margin="14,0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
          <TextBlock Text="PROBLEMS" FontSize="11" Classes="muted" />
          <TextBlock Text="OUTPUT" FontSize="11" Foreground="{DynamicResource TorenAccentBrush}" FontWeight="SemiBold" />
          <TextBlock Text="TERMINAL" FontSize="11" Classes="muted" />
          <TextBlock Text="TESTS" FontSize="11" Classes="muted" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
          <StackPanel Spacing="6">
            <TextBlock Text="No output yet" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Classes="muted" Text="Build, restore, test, and tool output will appear here as those capabilities are implemented." FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border
        Grid.Row="3"
        Grid.ColumnSpan="3"
        Background="{DynamicResource TorenSurfaceRaisedBrush}"
        BorderBrush="{DynamicResource TorenBorderBrush}"
        BorderThickness="0,1,0,0">
      <Grid Margin="10,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="{DynamicResource TorenSuccessBrush}" FontSize="8" />
          <TextBlock Text="{Binding StatusText}" FontSize="10" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="subtle" Text="Toren IDE · Preview" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
