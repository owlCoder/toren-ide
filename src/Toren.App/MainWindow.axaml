<Window x:Class="Toren.App.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainWindowViewModel"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toren.App.ViewModels"
        xmlns:icons="clr-namespace:Toren.App.Views.Explorer"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        CanResize="True" WindowDecorations="None" Title="Toren IDE">
  <Window.Styles>
    <StyleInclude Source="avares://Toren.App/Styles/TorenMainWindowTheme.axaml" />
  </Window.Styles>

  <Grid x:Name="ShellGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
      <RowDefinition Height="320" MinHeight="300" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="270" MinWidth="240" MaxWidth="420" />
      <ColumnDefinition Width="*" MinWidth="600" />
    </Grid.ColumnDefinitions>
    <!-- Window chrome and global actions -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Height="{StaticResource TorenTitleBarHeight}"
            Classes="shell-surface title-bar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Padding="12,0,10,0" Background="Transparent"
                PointerPressed="TitleBar_OnPointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="9"
                    Background="{DynamicResource TorenAccentMutedBrush}"
                    BorderBrush="{DynamicResource TorenAccentBrush}" BorderThickness="1">
              <TextBlock Text="T" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource TorenAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="chrome-label" Text="Toren IDE" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="8,0" Background="Transparent"
                PointerPressed="TitleBar_OnPointerPressed" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="window-control" Click="MinimizeWindow_OnClick" ToolTip.Tip="Minimize"
                  AutomationProperties.Name="Minimize window">
            <Grid Width="16" Height="16">
              <Border Width="12" Height="1.5" CornerRadius="0.75"
                      Background="{DynamicResource TorenTextMutedBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </Grid>
          </Button>
          <Button Classes="window-control" Click="ToggleMaximizeWindow_OnClick" ToolTip.Tip="Maximize or restore"
                  AutomationProperties.Name="Maximize or restore window">
            <Path Classes="shell-icon" Data="{StaticResource TorenIconWindowMaximize}" Width="16" Height="16" />
          </Button>
          <Button Classes="window-control close" Click="CloseWindow_OnClick" ToolTip.Tip="Close"
                  AutomationProperties.Name="Close window">
            <Path Classes="shell-icon" Data="{StaticResource TorenIconClose}" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- IDE command bar: editor actions plus runtime-wired build/run controls. -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Height="42" Classes="command-bar"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,0,12,0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="toolbar-button open-menu-button" x:Name="OpenWorkspaceButton"
                Margin="0,0,4,0" VerticalAlignment="Center"
                ToolTip.Tip="Open a folder, solution, or project"
                AutomationProperties.Name="Open workspace menu">
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuItem Header="Open Folder…" Click="OpenFolder_OnClick">
                <MenuItem.Icon>
                  <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Open Solution or Project…" Click="OpenWorkspaceFile_OnClick">
                <MenuItem.Icon>
                  <Path Classes="shell-icon" Data="{StaticResource TorenIconSolution}" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Classes="action-content">
            <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
            <TextBlock Text="Open" />
            <Path Classes="shell-icon menu-chevron" Data="{StaticResource TorenIconChevronDown}" />
          </StackPanel>
        </Button>

          <Button Classes="command-button" Click="SaveActiveDocument_OnClick"
                  IsEnabled="{Binding Documents.HasActiveDocument}"
                  ToolTip.Tip="Save active document (Ctrl/Cmd+S)"
                  AutomationProperties.Name="Save active document">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource TorenTextMutedBrush}"
                  Data="M5,3H17L21,7V21H3V3H5M7,5V10H17V5H7M7,13V19H17V13H7Z" />
          </Button>
          <Button Classes="command-button" Click="Undo_OnClick"
                  IsEnabled="{Binding Documents.HasActiveDocument}"
                  ToolTip.Tip="Undo" AutomationProperties.Name="Undo">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource TorenTextMutedBrush}"
                  Data="M7.5,7H13C16.31,7 19,9.69 19,13C19,16.31 16.31,19 13,19H8V17H13C15.21,17 17,15.21 17,13C17,10.79 15.21,9 13,9H7.5L11,12.5L9.59,13.91L3.67,8L9.59,2.09L11,3.5L7.5,7Z" />
          </Button>
          <Button Classes="command-button" Click="Redo_OnClick"
                  IsEnabled="{Binding Documents.HasActiveDocument}"
                  ToolTip.Tip="Redo" AutomationProperties.Name="Redo">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource TorenTextMutedBrush}"
                  Data="M16.5,7H11C7.69,7 5,9.69 5,13C5,16.31 7.69,19 11,19H16V17H11C8.79,17 7,15.21 7,13C7,10.79 8.79,9 11,9H16.5L13,12.5L14.41,13.91L20.33,8L14.41,2.09L13,3.5L16.5,7Z" />
          </Button>
          <Border Width="1" Height="18" Margin="5,0"
                  Background="{DynamicResource TorenBorderBrush}" />
          <Button x:Name="BuildSolutionButton" Classes="toolbar-button build-action" Content="Build"
                  ToolTip.Tip="Build Solution (Ctrl/Cmd+Shift+B)" AutomationProperties.Name="Build Solution" IsEnabled="False" />
          <Button x:Name="RebuildSolutionButton" Classes="toolbar-button" Content="Rebuild"
                  ToolTip.Tip="Rebuild Solution" AutomationProperties.Name="Rebuild Solution" IsEnabled="False" />
          <Button x:Name="CleanSolutionButton" Classes="toolbar-button" Content="Clean"
                  ToolTip.Tip="Clean Solution" AutomationProperties.Name="Clean Solution" IsEnabled="False" />
          <Border Width="1" Height="18" Margin="5,0" Background="{DynamicResource TorenBorderBrush}" />
          <ComboBox x:Name="BuildConfigurationSelector" Classes="command-select" Width="96"
                    SelectedIndex="0" IsEnabled="False"
                    ToolTip.Tip="Build configuration" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="Build configuration">
            <ComboBoxItem Content="Debug" />
            <ComboBoxItem Content="Release" />
          </ComboBox>
          <ComboBox x:Name="StartupProjectSelector" Classes="command-select" Width="160" PlaceholderText="Startup project"
                    SelectedIndex="-1" IsEnabled="False"
                    ToolTip.Tip="Startup project" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="Startup project" />
          <Button x:Name="RunStartupProjectButton" Classes="command-button run" IsEnabled="False"
                  ToolTip.Tip="Run selected startup project (F5)" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="Run selected startup project">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource TorenSuccessBrush}"
                  Data="M8,5V19L19,12L8,5Z" />
          </Button>
          <Button x:Name="CancelExecutionButton" Classes="command-button" IsEnabled="False"
                  ToolTip.Tip="Stop current command (Shift+F5)" AutomationProperties.Name="Stop current command">
            <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TorenErrorBrush}" Data="M4,4H20V20H4Z" />
          </Button>
        </StackPanel>
        <TextBlock x:Name="ExecutionStatusText" Grid.Column="1" HorizontalAlignment="Right" Classes="subtle"
                   Text="Open a workspace to build or run" TextTrimming="CharacterEllipsis" MaxWidth="520"
                   FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Inset activity controls keep a compact, keyboard-reachable tool rail. -->
    <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0"
            Width="{StaticResource TorenActivityWidth}" Classes="shell-surface activity-rail"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Button x:Name="ExplorerActivityButton" Grid.Row="0" Classes="activity-button active"
                ToolTip.Tip="Explorer" AutomationProperties.Name="Explorer">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconExplorer}" />
        </Button>
        <Button x:Name="SourceControlActivityButton" Grid.Row="1" Classes="activity-button"
                IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Source Control" AutomationProperties.Name="Source Control">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconSourceControl}" />
        </Button>
        <Button x:Name="TestsActivityButton" Grid.Row="2" Classes="activity-button"
                IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Tests" AutomationProperties.Name="Tests">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconTests}" />
        </Button>
        <Button x:Name="DebugActivityButton" Grid.Row="3" Classes="activity-button"
                IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Debug" AutomationProperties.Name="Debug">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconDebug}" />
        </Button>
        <Button x:Name="HttpActivityButton" Grid.Row="4" Classes="activity-button" IsEnabled="False"
                ToolTip.Tip="HTTP Client" AutomationProperties.Name="HTTP Client">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconHttp}" />
        </Button>
        <Button x:Name="DataActivityButton" Grid.Row="5" Classes="activity-button" IsEnabled="False"
                ToolTip.Tip="Data and Docker" AutomationProperties.Name="Data and Docker">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconData}" />
        </Button>
        <Button x:Name="PackagesActivityButton" Grid.Row="6" Classes="activity-button" IsEnabled="False"
                ToolTip.Tip="Packages" AutomationProperties.Name="Packages">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconProject}" />
        </Button>
        <Button x:Name="SettingsActivityButton" Grid.Row="8" Classes="activity-button"
                IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
          <Path Classes="shell-icon" Data="{StaticResource TorenIconSettings}" />
        </Button>
      </Grid>
    </Border>

    <!-- Explorer: workspace nodes are loaded as they are expanded. -->
    <Border x:Name="ExplorerPanel" Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Classes="shell-surface" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Height="{StaticResource TorenPanelHeaderHeight}" Padding="14,0"
                BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="shell-icon" Width="16" Height="16" Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center" Data="{StaticResource TorenIconExplorer}" /><TextBlock Classes="panel-heading" Text="Explorer" /></StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="panel-card" Margin="10,10,10,8"><StackPanel Spacing="5">
          <TextBlock Text="{Binding WorkspaceTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding WorkspacePath}" FontSize="11" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkspacePath}" />
        </StackPanel></Border>
        <StackPanel Grid.Row="2" Margin="14,8" Spacing="9" VerticalAlignment="Top"
                    IsVisible="{Binding Explorer.IsEmpty}">
          <Border Height="1" Background="{DynamicResource TorenBorderBrush}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Open a workspace to browse its files and projects." Margin="0,6,0,0" />
          <Button Classes="link-button" Click="OpenFolder_OnClick" HorizontalAlignment="Left"
                  AutomationProperties.Name="Open Folder">
            <StackPanel Classes="action-content">
              <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
              <TextBlock Text="Open Folder" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TreeView Grid.Row="2" x:Name="WorkspaceTree" Classes="explorer-tree"
                  ItemsSource="{Binding Explorer.Roots}" IsVisible="{Binding Explorer.IsWorkspaceOpen}"
                  Margin="4,0,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <icons:ExplorerNodeIcon Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                           IsVisible="{Binding IsContent}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                           IsVisible="{Binding IsPlaceholder}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <Border Grid.Row="3" Padding="14,10" BorderBrush="{DynamicResource TorenBorderBrush}"
                BorderThickness="0,1,0,0">
          <TextBlock Classes="subtle" Text="Standard .NET workspaces" FontSize="11" />
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Width="5"
                  HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                  Classes="shell-splitter" AutomationProperties.Name="Resize sidebar"
                  ToolTip.Tip="Drag or use arrow keys to resize the sidebar" />

    <!-- Document host: real files open as tabs and are edited with AvaloniaEdit. -->
    <Grid x:Name="DocumentHost" Grid.Row="2" Grid.Column="2" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Height="{StaticResource TorenPanelHeaderHeight}"
              Background="{DynamicResource TorenSurfaceBrush}"
              BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <Border IsVisible="{Binding IsWelcomeOpen}" MinWidth="156"
                    Classes="document-tab" Classes.active="{Binding IsWelcomeSelected}"
                    PointerPressed="WelcomeTab_OnPointerPressed">
              <Grid RowDefinitions="*,2">
                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="7" Margin="12,0,6,0">
                  <Path Grid.Column="0" Classes="shell-icon" Width="14" Height="14"
                        Fill="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center"
                        Data="{StaticResource TorenIconWelcome}" />
                  <TextBlock Grid.Column="1" Text="Welcome" FontSize="12" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="tab-close" Width="26" Height="26" MinHeight="26"
                          Padding="0" Click="CloseWelcome_OnClick" ToolTip.Tip="Close Welcome"
                          AutomationProperties.Name="Close Welcome tab">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconClose}" Width="12" Height="12" />
                  </Button>
                </Grid>
                <Border Grid.Row="1" Height="2" Margin="10,0" CornerRadius="1" Background="{DynamicResource TorenAccentBrush}"
                        IsVisible="{Binding IsWelcomeSelected}" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Documents.OpenDocuments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OpenDocumentViewModel">
                  <Border MinWidth="130" MaxWidth="240"
                          Classes="document-tab" Classes.active="{Binding IsActive}"
                          PointerPressed="DocumentTab_OnPointerPressed" ToolTip.Tip="{Binding Path}">
                    <Grid RowDefinitions="*,2">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="12,0,6,0">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Ellipse Grid.Column="1" Width="6" Height="6" IsVisible="{Binding IsDirty}"
                                 Fill="{DynamicResource TorenTextMutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="tab-close" Width="26" Height="26" MinHeight="26"
                                Padding="0" Click="CloseDocument_OnClick" ToolTip.Tip="Close document"
                                AutomationProperties.Name="Close document tab">
                          <Path Classes="shell-icon" Data="{StaticResource TorenIconClose}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                      <Border Grid.Row="1" Height="2" Margin="10,0" CornerRadius="1" Background="{DynamicResource TorenAccentBrush}"
                              IsVisible="{Binding IsActive}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="1" Background="{DynamicResource TorenBackgroundBrush}">
        <ScrollViewer IsVisible="{Binding IsWelcomeContentVisible}" HorizontalScrollBarVisibility="Disabled">
          <Grid MaxWidth="860" HorizontalAlignment="Stretch" Margin="32,24,32,16"
                RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20">
            <StackPanel Grid.Row="0" Spacing="8">
              <TextBlock Text="Toren IDE" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="14"
                         Text="Modern .NET development without project lock-in." TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="28">
              <StackPanel Grid.Column="0" Spacing="9">
                <TextBlock Text="Start" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Button Classes="primary-action" Click="OpenFolder_OnClick" AutomationProperties.Name="Open Folder"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
                    <TextBlock Text="Open Folder" />
                  </StackPanel>
                </Button>
                <Button Classes="toolbar-button" Click="OpenWorkspaceFile_OnClick"
                        AutomationProperties.Name="Open Solution or Project" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconSolution}" />
                    <TextBlock Text="Open Solution or Project" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Button Classes="toolbar-button planned-action" IsEnabled="False"
                          AutomationProperties.Name="New Project, planned"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="Planned after the current MVP release scope" ToolTip.ShowOnDisabled="True">
                    <StackPanel Classes="action-content">
                      <Path Classes="shell-icon" Data="{StaticResource TorenIconNew}" />
                      <TextBlock Text="New Project" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Classes="subtle" Text="Planned"
                             FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Recent" FontSize="15" FontWeight="SemiBold" />
                <Border Classes="card" Padding="16" IsVisible="{Binding IsRecentEmpty}">
                  <StackPanel Spacing="7">
                    <TextBlock Text="No recent workspaces yet" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Folders, solutions, and projects you open will appear here." />
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding RecentWorkspaces}" IsVisible="{Binding HasRecentWorkspaces}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="link-button" Click="OpenRecent_OnClick"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{Binding DisplayName}" ToolTip.Tip="{Binding Path}">
                        <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                          <Path Classes="shell-icon" Width="16" Height="16" VerticalAlignment="Center"
                                Data="{StaticResource TorenIconRecent}" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="subtle" Text="{Binding Path}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Height="1" Background="{DynamicResource TorenBorderBrush}" />
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="28">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Learn" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide/tree/main/docs"
                        AutomationProperties.Name="Toren documentation" Click="OpenLink_OnClick" ToolTip.Tip="Open Toren documentation in your browser">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconDocs}" />
                    <TextBlock Text="Toren documentation" />
                  </StackPanel>
                </Button>
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide#build-from-source"
                        AutomationProperties.Name="Getting started" Click="OpenLink_OnClick" ToolTip.Tip="Open the getting started instructions">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconGuide}" />
                    <TextBlock Text="Getting started" />
                  </StackPanel>
                </Button>
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide"
                        AutomationProperties.Name="GitHub repository" Click="OpenLink_OnClick" ToolTip.Tip="Open the Toren repository">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconExternal}" />
                    <TextBlock Text="GitHub repository" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Button Classes="link-button planned-action" IsEnabled="False"
                          AutomationProperties.Name="Keyboard shortcut reference, planned"
                          ToolTip.Tip="Shortcut remapping is available in Settings; a dedicated reference view is planned"
                          ToolTip.ShowOnDisabled="True">
                    <StackPanel Classes="action-content">
                      <Path Classes="shell-icon" Data="{StaticResource TorenIconKeyboard}" />
                      <TextBlock Text="Keyboard shortcuts" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Classes="subtle" Text="Planned"
                             FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="13">
                <TextBlock Text="Environment" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="11">
                  <TextBlock Classes="subtle" Text="SDK" FontSize="12" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SdkSummary}" FontSize="12" />
                  <TextBlock Grid.Row="1" Classes="subtle" Text="Platform" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding PlatformSummary}" FontSize="12" />
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding IsWelcomeClosed}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="No document open" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Double-click a file in Explorer to open it."
                     FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
        <ae:TextEditor x:Name="DocumentEditor"
                       IsVisible="{Binding Documents.HasActiveDocument}"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code, Menlo, Consolas, monospace"
                       FontSize="13.5"
                       Background="{DynamicResource TorenBackgroundBrush}"
                       Foreground="{DynamicResource TorenTextBrush}"
                       LineNumbersForeground="{DynamicResource TorenTextSubtleBrush}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>

    <!-- Tool window: TabControl supplies keyboard selection and runtime tool content. -->
    <Border x:Name="ToolPanel" Grid.Row="3" Grid.Column="2"
            Classes="shell-surface" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="6,*">
        <TabControl x:Name="ToolTabs" Grid.Row="1" Classes="tool-tabs bottom-tool-tabs" SelectedIndex="1">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="shell-icon" Data="{StaticResource TorenIconProblems}" Width="14" Height="14" />
                <TextBlock Text="Problems" VerticalAlignment="Center" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="No problems to show" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="Project, build, and editor diagnostics appear here." FontSize="11" />
            </StackPanel>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="shell-icon" Data="{StaticResource TorenIconOutput}" Width="14" Height="14" />
                <TextBlock Text="Output" VerticalAlignment="Center" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="No output yet" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="Build, run, restore, and tool output appears here." FontSize="11" />
            </StackPanel>
          </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,3,6,0" Spacing="2">
          <Button x:Name="ExpandToolPanelButton" Classes="panel-control" ToolTip.Tip="Maximize panel"
                  AutomationProperties.Name="Maximize panel">
            <Path Classes="shell-icon" Width="14" Height="14" Data="{StaticResource TorenIconChevronUp}" />
          </Button>
          <Button x:Name="HideToolPanelButton" Classes="panel-control" ToolTip.Tip="Hide panel (Ctrl/Cmd+J)"
                  AutomationProperties.Name="Hide panel">
            <Path Classes="shell-icon" Width="14" Height="14" Data="{StaticResource TorenIconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <GridSplitter x:Name="ToolPanelSplitter" Grid.Row="3" Grid.Column="2" Height="6"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent"
                  Classes="shell-splitter" AutomationProperties.Name="Resize tool panel"
                  ToolTip.Tip="Drag or use arrow keys to resize the tool panel" />

    <!-- Compact status bar with theme switching and known runtime state. -->
    <Border Grid.Row="4" Grid.ColumnSpan="3" Height="{StaticResource TorenStatusBarHeight}"
            Background="{DynamicResource TorenSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource TorenSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}" />
        </Grid>
        <ProgressBar x:Name="ExecutionProgressBar" Grid.Column="1" Width="140" MinWidth="0" Height="3" MinHeight="0"
                     Foreground="{DynamicResource TorenAccentBrush}"
                     VerticalAlignment="Center" IsIndeterminate="True" IsVisible="False"
                     AutomationProperties.Name="Command progress" />
        <Button Grid.Column="2" x:Name="ToggleToolPanelButton" Classes="theme-toggle"
                ToolTip.Tip="Toggle panel (Ctrl/Cmd+J)" AutomationProperties.Name="Toggle panel">
          <Path Classes="shell-icon" Width="14" Height="14" Data="{StaticResource TorenIconPanel}" />
        </Button>
        <Button Grid.Column="3" x:Name="ThemeToggleButton" Classes="theme-toggle"
                Click="ToggleTheme_OnClick" ToolTip.Tip="Switch theme"
                AutomationProperties.Name="Toggle light and dark theme">
          <Grid Width="14" Height="14">
            <Path x:Name="ThemeSunIcon" Width="14" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource TorenTextMutedBrush}"
                  Data="M12,7A5,5 0 1,0 12,17A5,5 0 0,0 12,7M12,2L13.1,4.4L15.5,3.3L15.2,5.9L17.8,5.6L16.7,8L19.1,9.1L17,11L19.1,12.9L16.7,14L17.8,16.4L15.2,16.1L15.5,18.7L13.1,17.6L12,20L10.9,17.6L8.5,18.7L8.8,16.1L6.2,16.4L7.3,14L4.9,12.9L7,11L4.9,9.1L7.3,8L6.2,5.6L8.8,5.9L8.5,3.3L10.9,4.4L12,2Z" />
            <Path x:Name="ThemeMoonIcon" Width="14" Height="14" Stretch="Uniform" IsVisible="False"
                  Fill="{DynamicResource TorenTextMutedBrush}"
                  Data="M12.1,2C7.07,2 3,6.07 3,11.1C3,16.13 7.07,20.2 12.1,20.2C16.04,20.2 19.4,17.7 20.67,14.2C19.33,15.04 17.75,15.53 16.05,15.53C11.74,15.53 8.25,12.04 8.25,7.73C8.25,5.62 9.09,3.71 10.45,2.3C11,2.1 11.54,2 12.1,2Z" />
          </Grid>
        </Button>
        <TextBlock Grid.Column="4" Classes="subtle" Text="{Binding SdkSummary}" FontSize="11"
                   MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SdkSummary}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
