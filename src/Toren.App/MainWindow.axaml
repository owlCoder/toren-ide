<Window x:Class="Toren.App.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainWindowViewModel"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toren.App.ViewModels"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        CanResize="True" WindowDecorations="None" Title="Toren IDE">
  <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,Auto,*">
    <!-- Window chrome and global actions -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Height="{StaticResource TorenTitleBarHeight}"
            Classes="shell-surface title-bar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Column="0" Padding="12,0,10,0" Background="Transparent"
                PointerPressed="TitleBar_OnPointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="7"
                    Background="{DynamicResource TorenAccentMutedBrush}"
                    BorderBrush="{DynamicResource TorenAccentBrush}" BorderThickness="1">
              <TextBlock Text="T" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource TorenAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="chrome-label" Text="Toren IDE" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button Grid.Column="1" Classes="toolbar-button open-menu-button"
                Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip.Tip="Open a folder, solution, or project"
                AutomationProperties.Name="Open workspace menu">
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuItem Header="Open Folder…" Click="OpenFolder_OnClick">
                <MenuItem.Icon>
                  <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Open Solution or Project…" Click="OpenWorkspaceFile_OnClick">
                <MenuItem.Icon>
                  <Path Classes="shell-icon" Data="{StaticResource TorenIconSolution}" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Classes="action-content">
            <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
            <TextBlock Text="Open" />
            <Path Classes="shell-icon menu-chevron" Data="M3 6L8 11L13 6" />
          </StackPanel>
        </Button>
        <Border Grid.Column="2" Margin="8,0" Background="Transparent"
                PointerPressed="TitleBar_OnPointerPressed">
          <TextBlock Classes="subtle chrome-label" Text="{Binding WorkspaceTitle}"
                     FontSize="11" TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Classes="window-control" Click="MinimizeWindow_OnClick" ToolTip.Tip="Minimize"
                  AutomationProperties.Name="Minimize window">
            <Rectangle Width="12" Height="1.5" Fill="{DynamicResource TorenTextMutedBrush}" />
          </Button>
          <Button Classes="window-control" Click="ToggleMaximizeWindow_OnClick" ToolTip.Tip="Maximize or restore"
                  AutomationProperties.Name="Maximize or restore window">
            <Path Classes="shell-icon" Data="M3 3H13V13H3Z" Width="14" Height="14" />
          </Button>
          <Button Classes="window-control close" Click="CloseWindow_OnClick" ToolTip.Tip="Close"
                  AutomationProperties.Name="Close window">
            <Path Classes="shell-icon" Data="M3 3L13 13 M13 3L3 13" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Activity bar: Toren-owned 18 px path icons with one visual weight -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
            Width="{StaticResource TorenActivityWidth}" Classes="shell-surface activity-rail"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Button Grid.Row="0" Classes="activity-button active" ToolTip.Tip="Explorer"
                AutomationProperties.Name="Explorer" IsTabStop="False">
          <Path Classes="shell-icon" Data="M2 3H14V13H2Z M5 3V13 M7.5 6H12 M7.5 9H12" />
        </Button>
        <Button Grid.Row="1" Classes="activity-button" IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Source control — coming in MVP 1.0" AutomationProperties.Name="Source control, coming in MVP 1.0">
          <Path Classes="shell-icon" Data="M5 3V11A2 2 0 0 0 7 13H11 M5 3A1.5 1.5 0 1 0 5 6A1.5 1.5 0 1 0 5 3 M11 10A1.5 1.5 0 1 0 11 13A1.5 1.5 0 1 0 11 10" />
        </Button>
        <Button Grid.Row="2" Classes="activity-button" IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Tests — coming in MVP 1.0" AutomationProperties.Name="Tests, coming in MVP 1.0">
          <Path Classes="shell-icon" Data="M5 2H11 M6 2V7L3 13H13L10 7V2 M5 10H11" />
        </Button>
        <Button Grid.Row="3" Classes="activity-button" IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Debug — coming in MVP 1.0" AutomationProperties.Name="Debug, coming in MVP 1.0">
          <Path Classes="shell-icon" Data="M4 2L13 8L4 14Z" />
        </Button>
        <Button Grid.Row="5" Classes="activity-button" IsEnabled="False" ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="Settings — coming in MVP 1.0" AutomationProperties.Name="Settings, coming in MVP 1.0">
          <Path Classes="shell-icon" Data="M2 4H14 M2 8H14 M2 12H14 M6 2.5V5.5 M10 6.5V9.5 M6 10.5V13.5" />
        </Button>
      </Grid>
    </Border>

    <!-- Explorer: compact tree-ready side panel -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Classes="shell-surface"
            Width="{StaticResource TorenExplorerWidth}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Height="{StaticResource TorenPanelHeaderHeight}" Padding="14,0"
                BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Classes="tool-title" Text="EXPLORER" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="14,16,14,12" Spacing="5">
          <TextBlock Text="{Binding WorkspaceTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding WorkspacePath}" FontSize="11"
                     TextWrapping="Wrap" MaxLines="3" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="14,8" Spacing="9" VerticalAlignment="Top">
          <Border Height="1" Background="{DynamicResource TorenBorderBrush}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Files will appear here when a workspace is open." Margin="0,6,0,0" />
          <Button Classes="link-button" Click="OpenFolder_OnClick" HorizontalAlignment="Left"
                  AutomationProperties.Name="Open Folder">
            <StackPanel Classes="action-content">
              <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
              <TextBlock Text="Open Folder" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="3" Padding="14,10" BorderBrush="{DynamicResource TorenBorderBrush}"
                BorderThickness="0,1,0,0">
          <TextBlock Classes="subtle" Text="Standard .NET workspaces" FontSize="11" />
        </Border>
      </Grid>
    </Border>

    <!-- Document host: the tab pattern reserves space for future file icons and dirty state. -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Height="{StaticResource TorenPanelHeaderHeight}"
              Background="{DynamicResource TorenSurfaceBrush}"
              BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,0,0,1">
        <Border IsVisible="{Binding IsWelcomeOpen}" MinWidth="156" HorizontalAlignment="Left"
                Background="{DynamicResource TorenBackgroundBrush}"
                BorderBrush="{DynamicResource TorenAccentBrush}" BorderThickness="0,0,0,2"
                PointerPressed="WelcomeTab_OnPointerPressed">
          <Grid ColumnDefinitions="18,*,Auto,Auto" ColumnSpacing="7" Margin="12,0,6,0">
            <Path Grid.Column="0" Classes="shell-icon" Width="14" Height="14"
                  Stroke="{DynamicResource TorenAccentBrush}" VerticalAlignment="Center"
                  Data="M2 3H14V13H2Z M5 3V13" />
            <TextBlock Grid.Column="1" Text="Welcome" FontSize="12" VerticalAlignment="Center" />
            <Ellipse Grid.Column="2" Width="6" Height="6" IsVisible="False"
                     Fill="{DynamicResource TorenTextMutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="tab-close" Width="26" Height="26" MinHeight="26"
                    Padding="0" Click="CloseWelcome_OnClick" ToolTip.Tip="Close Welcome"
                    AutomationProperties.Name="Close Welcome tab">
              <Path Classes="shell-icon" Data="M3 3L13 13 M13 3L3 13" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
      </Border>
      <Grid Grid.Row="1" Background="{DynamicResource TorenBackgroundBrush}">
        <ScrollViewer IsVisible="{Binding IsWelcomeOpen}" HorizontalScrollBarVisibility="Disabled">
          <Grid MaxWidth="860" HorizontalAlignment="Stretch" Margin="48,48,48,32"
                RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="28">
            <StackPanel Grid.Row="0" Spacing="8">
              <TextBlock Text="Toren IDE" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="14"
                         Text="Modern .NET development without project lock-in." />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="28">
              <StackPanel Grid.Column="0" Spacing="9">
                <TextBlock Text="Start" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Button Classes="primary-action" Click="OpenFolder_OnClick" AutomationProperties.Name="Open Folder"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconFolder}" />
                    <TextBlock Text="Open Folder" />
                  </StackPanel>
                </Button>
                <Button Classes="toolbar-button" Click="OpenWorkspaceFile_OnClick"
                        AutomationProperties.Name="Open Solution or Project" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconSolution}" />
                    <TextBlock Text="Open Solution or Project" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Button Classes="toolbar-button planned-action" IsEnabled="False"
                          AutomationProperties.Name="New Project, coming in MVP 1.0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="Coming in MVP 1.0" ToolTip.ShowOnDisabled="True">
                    <StackPanel Classes="action-content">
                      <Path Classes="shell-icon" Data="{StaticResource TorenIconNew}" />
                      <TextBlock Text="New Project" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Classes="subtle" Text="MVP 1.0"
                             FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Recent" FontSize="15" FontWeight="SemiBold" />
                <Border Classes="card" Padding="16">
                  <StackPanel Spacing="7">
                    <TextBlock Text="No recent workspaces yet" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Recent folders, solutions, and projects will appear here when session history is available." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Height="1" Background="{DynamicResource TorenBorderBrush}" />
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="28">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Learn" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide/tree/main/docs"
                        AutomationProperties.Name="Toren documentation" Click="OpenLink_OnClick" ToolTip.Tip="Open Toren documentation in your browser">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconDocs}" />
                    <TextBlock Text="Toren documentation" />
                  </StackPanel>
                </Button>
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide#build-from-source"
                        AutomationProperties.Name="Getting started" Click="OpenLink_OnClick" ToolTip.Tip="Open the getting started instructions">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconGuide}" />
                    <TextBlock Text="Getting started" />
                  </StackPanel>
                </Button>
                <Button Classes="link-button" Tag="https://github.com/owlCoder/toren-ide"
                        AutomationProperties.Name="GitHub repository" Click="OpenLink_OnClick" ToolTip.Tip="Open the Toren repository">
                  <StackPanel Classes="action-content">
                    <Path Classes="shell-icon" Data="{StaticResource TorenIconExternal}" />
                    <TextBlock Text="GitHub repository" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Button Classes="link-button planned-action" IsEnabled="False"
                          AutomationProperties.Name="Keyboard shortcuts, coming in MVP 1.0"
                          ToolTip.Tip="Coming in MVP 1.0" ToolTip.ShowOnDisabled="True">
                    <StackPanel Classes="action-content">
                      <Path Classes="shell-icon" Data="{StaticResource TorenIconKeyboard}" />
                      <TextBlock Text="Keyboard shortcuts" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Classes="subtle" Text="MVP 1.0"
                             FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="13">
                <TextBlock Text="Environment" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="11">
                  <TextBlock Classes="subtle" Text="SDK" FontSize="12" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SdkSummary}" FontSize="12" />
                  <TextBlock Grid.Row="1" Classes="subtle" Text="Platform" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding PlatformSummary}" FontSize="12" />
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding IsWelcomeClosed}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="No document open" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Open a workspace to get started."
                     FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Tool window: TabControl supplies keyboard selection and future badge room. -->
    <Border Grid.Row="2" Grid.Column="2" Height="{StaticResource TorenToolWindowHeight}"
            Classes="shell-surface" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="4,*">
        <Border Height="4" Background="{DynamicResource TorenSurfaceRaisedBrush}">
          <Border Width="42" Height="2" CornerRadius="1"
                  Background="{DynamicResource TorenBorderStrongBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TabControl Grid.Row="1" Classes="tool-tabs" SelectedIndex="1">
          <TabItem Header="Problems">
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="No problems to show" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="Diagnostics will appear here when project analysis is available." FontSize="11" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Output">
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="No output yet" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="Build and tool output will appear here when those capabilities are available." FontSize="11" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Terminal">
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="Terminal is coming in MVP 1.0" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="The integrated shell is not available yet." FontSize="11" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Tests">
            <StackPanel Margin="17,14" Spacing="6">
              <TextBlock Text="Tests are coming in MVP 1.0" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Classes="muted" Text="Test discovery and results are not available yet." FontSize="11" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <!-- Compact status bar: only known state is displayed. -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Height="{StaticResource TorenStatusBarHeight}"
            Background="{DynamicResource TorenSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource TorenBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource TorenSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontSize="11" MaxWidth="640"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="subtle" Text="{Binding SdkSummary}" FontSize="11"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
