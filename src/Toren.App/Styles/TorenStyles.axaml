<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <SolidColorBrush x:Key="TorenBackgroundBrush">#121419</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceBrush">#171B21</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceRaisedBrush">#1D232B</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceHoverBrush">#242C36</SolidColorBrush>
    <SolidColorBrush x:Key="TorenChromeBrush">#14191F</SolidColorBrush>
    <SolidColorBrush x:Key="TorenBorderBrush">#2C3540</SolidColorBrush>
    <SolidColorBrush x:Key="TorenBorderStrongBrush">#3A4654</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextBrush">#E8ECF2</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextMutedBrush">#91A0B1</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextSubtleBrush">#6F7E8F</SolidColorBrush>
    <SolidColorBrush x:Key="TorenAccentBrush">#38BDF8</SolidColorBrush>
    <SolidColorBrush x:Key="TorenAccentMutedBrush">#103448</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSuccessBrush">#55D187</SolidColorBrush>
    <SolidColorBrush x:Key="TorenDangerHoverBrush">#B42336</SolidColorBrush>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource TorenBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="FontFamily" Value="Inter" />
  </Style>

  <Style Selector="Border.shell-surface">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
  </Style>

  <Style Selector="Border.title-bar">
    <Setter Property="Background" Value="{DynamicResource TorenChromeBrush}" />
  </Style>

  <Style Selector="Border.activity-rail">
    <Setter Property="Background" Value="{DynamicResource TorenChromeBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Border.card.compact-card">
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="Button.toolbar-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.primary-action">
    <Setter Property="Background" Value="{DynamicResource TorenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style Selector="Button.window-control">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.window-control:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
  </Style>

  <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenDangerHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.activity-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="18" />
  </Style>

  <Style Selector="Button.activity-button.active">
    <Setter Property="Foreground" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Button.activity-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
  </Style>

  <Style Selector="Button.activity-button:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.activity-button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.tool-title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.section-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource TorenTextSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource TorenAccentBrush}" />
  </Style>
</Styles>
