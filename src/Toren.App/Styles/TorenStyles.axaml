<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="TorenBackgroundBrush">#11151A</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceBrush">#191E25</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceRaisedBrush">#202732</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceHoverBrush">#293340</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSurfaceSelectedBrush">#18394B</SolidColorBrush>
    <SolidColorBrush x:Key="TorenChromeBrush">#171C23</SolidColorBrush>
    <SolidColorBrush x:Key="TorenBorderBrush">#303945</SolidColorBrush>
    <SolidColorBrush x:Key="TorenBorderStrongBrush">#475567</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextBrush">#E9EEF4</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextMutedBrush">#A5B3C3</SolidColorBrush>
    <SolidColorBrush x:Key="TorenTextSubtleBrush">#8494A7</SolidColorBrush>
    <SolidColorBrush x:Key="TorenAccentBrush">#53C8FB</SolidColorBrush>
    <SolidColorBrush x:Key="TorenAccentHoverBrush">#83D9FF</SolidColorBrush>
    <SolidColorBrush x:Key="TorenAccentMutedBrush">#153649</SolidColorBrush>
    <SolidColorBrush x:Key="TorenSuccessBrush">#70D9A1</SolidColorBrush>
    <SolidColorBrush x:Key="TorenWarningBrush">#EBC078</SolidColorBrush>
    <SolidColorBrush x:Key="TorenErrorBrush">#F28B91</SolidColorBrush>
    <SolidColorBrush x:Key="TorenDangerHoverBrush">#B93E4C</SolidColorBrush>
    <CornerRadius x:Key="TorenControlRadius">6</CornerRadius>
    <CornerRadius x:Key="TorenCardRadius">8</CornerRadius>
    <x:Double x:Key="TorenTitleBarHeight">46</x:Double>
    <x:Double x:Key="TorenActivityWidth">50</x:Double>
    <x:Double x:Key="TorenExplorerWidth">270</x:Double>
    <x:Double x:Key="TorenPanelHeaderHeight">38</x:Double>
    <x:Double x:Key="TorenToolWindowHeight">168</x:Double>
    <x:Double x:Key="TorenStatusBarHeight">24</x:Double>
    <x:Double x:Key="TorenControlHeight">32</x:Double>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource TorenBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Window:window-inactive TextBlock.chrome-label">
    <Setter Property="Opacity" Value="0.62" />
  </Style>
  <Style Selector="Border.shell-surface">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
  </Style>
  <Style Selector="Border.title-bar, Border.activity-rail">
    <Setter Property="Background" Value="{DynamicResource TorenChromeBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TorenCardRadius}" />
  </Style>
  <Style Selector="Path.shell-icon">
    <Setter Property="Stroke" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.toolbar-button, Button.link-button, Button.primary-action, Button.tab-close">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TorenControlRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource TorenControlHeight}" />
  </Style>
  <Style Selector="Button.toolbar-button, Button.link-button, Button.tab-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.link-button">
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter, Button.link-button:pointerover /template/ ContentPresenter, Button.tab-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
  </Style>
  <Style Selector="Button.primary-action">
    <Setter Property="Background" Value="{DynamicResource TorenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter, TabItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.57" />
  </Style>
  <Style Selector="Button.planned-action:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextSubtleBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.planned-action:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextSubtleBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-control">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-control:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.window-control:pointerover Path.shell-icon">
    <Setter Property="Stroke" Value="{DynamicResource TorenTextBrush}" />
  </Style>
  <Style Selector="Button.window-control:pointerover Rectangle">
    <Setter Property="Fill" Value="{DynamicResource TorenTextBrush}" />
  </Style>
  <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenDangerHoverBrush}" />
  </Style>
  <Style Selector="Button.activity-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.activity-button.active">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
  </Style>
  <Style Selector="Button.activity-button.active Path.shell-icon">
    <Setter Property="Stroke" Value="{DynamicResource TorenAccentBrush}" />
  </Style>
  <Style Selector="Button.activity-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.activity-button:pointerover Path.shell-icon">
    <Setter Property="Stroke" Value="{DynamicResource TorenTextBrush}" />
  </Style>
  <Style Selector="Button.activity-button.active:pointerover Path.shell-icon">
    <Setter Property="Stroke" Value="{DynamicResource TorenAccentBrush}" />
  </Style>
  <Style Selector="Button.activity-button:disabled">
    <Setter Property="Opacity" Value="0.56" />
  </Style>
  <Style Selector="Button.activity-button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.tool-tabs TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TabControl.tool-tabs TabItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
  </Style>
  <Style Selector="TabControl.tool-tabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TorenAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.tool-title, TextBlock.section-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource TorenTextSubtleBrush}" />
  </Style>
</Styles>
