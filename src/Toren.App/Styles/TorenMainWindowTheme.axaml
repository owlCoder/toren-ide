<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- Surface hierarchy follows VS Code's 2026 dark palette; see ui-review.md. -->
          <SolidColorBrush x:Key="TorenBackgroundBrush">#121314</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceBrush">#191A1B</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceRaisedBrush">#202122</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceHoverBrush">#242526</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceSelectedBrush">#263B43</SolidColorBrush>
          <SolidColorBrush x:Key="TorenChromeBrush">#191A1B</SolidColorBrush>
          <SolidColorBrush x:Key="TorenBorderBrush">#2A2B2C</SolidColorBrush>
          <SolidColorBrush x:Key="TorenBorderStrongBrush">#333536</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextBrush">#BFBFBF</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextMutedBrush">#96999C</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextSubtleBrush">#858889</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentBrush">#48A0C7</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentHoverBrush">#62B3D6</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentMutedBrush">#1E3A47</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSuccessBrush">#73C991</SolidColorBrush>
          <SolidColorBrush x:Key="TorenWarningBrush">#E5BA7D</SolidColorBrush>
          <SolidColorBrush x:Key="TorenErrorBrush">#F48771</SolidColorBrush>
          <SolidColorBrush x:Key="TorenDangerHoverBrush">#C42B1C</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconFolderBrush">#C8AD78</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconFolderOpenBrush">#D9B875</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconSolutionBrush">#B19BC7</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconProjectBrush">#75B5CE</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconTestBrush">#83B392</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconReferenceBrush">#4EC9B0</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconCodeBrush">#9BBECD</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconDataBrush">#D4BA91</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconMarkupBrush">#CE9178</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconDocumentBrush">#9BBECD</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconConfigBrush">#AAB2BF</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconContainerBrush">#75B5CE</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconImageBrush">#B19BC7</SolidColorBrush>
          <SolidColorBrush x:Key="TorenEditorForegroundBrush">#BBBEBF</SolidColorBrush>
          <SolidColorBrush x:Key="TorenEditorSelectionBrush">#24556C</SolidColorBrush>
          <SolidColorBrush x:Key="TorenEditorLineHighlightBrush">#1C1E20</SolidColorBrush>
          <SolidColorBrush x:Key="TorenEditorLineNumberBrush">#858889</SolidColorBrush>

          <!-- Theme-native control states use the same surfaces as the shell. -->
          <StaticResource x:Key="ButtonBackground" ResourceKey="TorenSurfaceRaisedBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="TorenBorderBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TorenSurfaceHoverBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TorenBorderStrongBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TorenSurfaceSelectedBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TorenAccentBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="TorenBorderBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="TextControlBackground" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="TorenSurfaceRaisedBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TorenTextSubtleBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="TorenBorderStrongBrush" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="TorenAccentBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="TorenBorderBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TorenTextSubtleBrush" />
          <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
          <StaticResource x:Key="ComboBoxBackground" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="TorenSurfaceHoverBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="TorenSurfaceSelectedBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="TorenSurfaceBrush" />
          <StaticResource x:Key="ComboBoxForeground" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="TorenTextBrush" />
          <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="TorenBorderStrongBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="TorenAccentBrush" />
          <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="TorenAccentBrush" />
          <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="TorenBorderStrongBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="TorenBorderBrush" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="TorenSurfaceRaisedBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="TorenBorderStrongBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TorenTextSubtleBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="TorenTextMutedBrush" />
          <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="TorenTextSubtleBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TorenBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceBrush">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceRaisedBrush">#EAEAEA</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceHoverBrush">#E6E6E6</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSurfaceSelectedBrush">#DCECF7</SolidColorBrush>
          <SolidColorBrush x:Key="TorenChromeBrush">#F7F7F8</SolidColorBrush>
          <SolidColorBrush x:Key="TorenBorderBrush">#D0D0D0</SolidColorBrush>
          <SolidColorBrush x:Key="TorenBorderStrongBrush">#A8A8A8</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextBrush">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextMutedBrush">#57606A</SolidColorBrush>
          <SolidColorBrush x:Key="TorenTextSubtleBrush">#7D8590</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentBrush">#0078D4</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentHoverBrush">#106EBE</SolidColorBrush>
          <SolidColorBrush x:Key="TorenAccentMutedBrush">#DCEEFF</SolidColorBrush>
          <SolidColorBrush x:Key="TorenSuccessBrush">#107C10</SolidColorBrush>
          <SolidColorBrush x:Key="TorenWarningBrush">#8A6D1D</SolidColorBrush>
          <SolidColorBrush x:Key="TorenErrorBrush">#C42B1C</SolidColorBrush>
          <SolidColorBrush x:Key="TorenDangerHoverBrush">#A80000</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconFolderBrush">#C07C00</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconFolderOpenBrush">#B76E00</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconSolutionBrush">#7A3E9D</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconProjectBrush">#0078D4</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconTestBrush">#107C10</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconReferenceBrush">#16825D</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconCodeBrush">#005FB8</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconDataBrush">#986F0B</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconMarkupBrush">#A31515</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconDocumentBrush">#0067C0</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconConfigBrush">#57606A</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconContainerBrush">#0078D4</SolidColorBrush>
          <SolidColorBrush x:Key="TorenIconImageBrush">#7A3E9D</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.command-bar">
    <Setter Property="Background" Value="{DynamicResource TorenChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
    <Setter Property="Padding" Value="0,0,0,2" />
  </Style>

  <Style Selector="Button.command-button">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>
  <Style Selector="Button.command-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
  </Style>
  <Style Selector="Button.command-button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.command-button.run">
    <Setter Property="Foreground" Value="{DynamicResource TorenSuccessBrush}" />
  </Style>

  <Style Selector="ComboBox.command-select">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TorenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ComboBox.command-select:disabled">
    <Setter Property="Opacity" Value="0.56" />
  </Style>

  <Style Selector="Button.theme-toggle">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextMutedBrush}" />
  </Style>
  <Style Selector="Button.theme-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TorenTextBrush}" />
  </Style>

  <Style Selector="ListBox.problems-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.problems-list > ListBoxItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.problems-list > ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.problems-list > ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource TorenSurfaceSelectedBrush}" />
  </Style>
</Styles>
